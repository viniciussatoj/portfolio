---
/* Laboratorio das barras de gradiente em pixel art. Usa as mesmas pecas
   dos cases — SectionTitle, barra.ts, dither-config.ts e o mesmo painel —
   mais uma barra de progresso de leitura no topo.
   Fora do sitemap (astro.config) — e pagina de experimento. */
import Base from "../layouts/Base.astro";
import SectionTitle from "../components/blocks/SectionTitle.astro";

const secoes = Array.from({ length: 8 }, (_, i) => i + 1);
const paragrafo =
  "Pixel art lives on constraints: a fixed grid, a short palette and no blending between colors. Dithering is how it fakes the in-between — a pattern of two neighbouring colors that the eye averages into a third one. The bar above uses exactly the stops of the gradient as its palette, and lets the dithering decide which one each cell shows.";
---

<Base title="Dither progress — lab" description="Pixel art reading progress bar experiment.">
  <canvas id="dp-barra" class="dp-barra" aria-hidden="true"></canvas>

  <main class="dp-conteudo">
    <h1>Dither progress</h1>
    <p class="dp-lead">Role a página para encher as barras. Os controles ficam no painel à direita.</p>
    {secoes.map((n) => (
      <section>
        <SectionTitle bar>Section_{n}</SectionTitle>
        <p>{paragrafo}</p>
        <p>{paragrafo}</p>
        <p>{paragrafo}</p>
      </section>
    ))}
  </main>

  <aside class="dp-painel" id="dp-painel" aria-label="Controles das barras"></aside>
</Base>

<style>
  .dp-barra {
    position: fixed;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    z-index: 10;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .dp-conteudo {
    max-width: 640px;
    margin: 0 auto;
    padding: 160px 24px 50vh;
    color: var(--text-muted);
  }
  .dp-conteudo h1 { color: var(--text); font-size: 40px; line-height: 1.1; }
  .dp-conteudo p + p { margin-top: 16px; }
  .dp-lead { margin-top: 12px; }

  /* Painel: faixa de gradiente + raiz inline do DialKit. */
  .dp-painel {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 20;
    width: 300px;
    max-height: calc(100vh - 32px);
    overflow: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 8px;
    scrollbar-width: thin;
  }
  @media (max-width: 640px) {
    .dp-painel { left: 16px; right: 16px; width: auto; top: auto; bottom: 16px; max-height: 55vh; }
  }
</style>

<script>
  import { alvoDaBarra, colunasEm, montarBarra, montarPreenchimento, rolagemAtiva } from "../scripts/dither-progress";
  import { montarPainel } from "../scripts/dither-progress-panel";
  import { montarBarras } from "../scripts/barra";
  import { DITHER, type Ajustes } from "../scripts/dither-config";

  /* As barras dos titulos sao as mesmas dos cases. */
  const barras = montarBarras();

  /* A barra do topo ocupa a largura da janela, sem o scrollbar. */
  let ajustes: Ajustes = DITHER;
  const painel = montarPainel(
    (a) => {
      ajustes = a;
      barras.aplicar(a);
    },
    { id: "dither-progress", padrao: DITHER, host: document.querySelector<HTMLElement>("#dp-painel")! },
  );

  const topo = montarBarra(document.querySelector<HTMLCanvasElement>("#dp-barra")!);
  const preenchimento = montarPreenchimento();
  let desenhado: Ajustes | null = null;
  let chaveDesenhada = "";

  function quadro(agora: number) {
    const cfg = { ...ajustes, cols: colunasEm(document.documentElement.clientWidth, ajustes) };
    const teto = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const rolagem = Math.min(1, Math.max(0, scrollY / teto));

    const cobertura = preenchimento.passo(cfg, alvoDaBarra(rolagem, { velocidade: rolagemAtiva(cfg).velocidade, minimo: cfg.minimo }), agora);
    /* Redesenha se o preenchimento andou, ou se mudou o config ou a largura. */
    const chave = `${cfg.cols}`;
    if (preenchimento.consumirMudanca() || ajustes !== desenhado || chave !== chaveDesenhada) {
      desenhado = ajustes;
      chaveDesenhada = chave;
      topo.desenhar(cfg, cobertura);
    }

    let soma = 0;
    for (const c of cobertura) soma += c;
    painel.leitura(`${cfg.cols} × ${cfg.rows} · Rolagem ${Math.round(rolagem * 100)}% · Barra ${Math.round((soma / cobertura.length) * 100)}%`);
    requestAnimationFrame(quadro);
  }

  requestAnimationFrame(quadro);
</script>
