---
/* Laboratorio das lombadas VHS do "Next case". Cada set mostra os tres
   cases lado a lado com uma variacao, para comparar contra o banner que
   esta no ar. Fora do sitemap (astro.config) — e pagina de experimento. */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";
import VhsBanner from "../components/VhsBanner.astro";
import VhsShelf from "../components/VhsShelf.astro";

const cases = (await getCollection("cases", (c) => !c.data.draft)).sort((a, b) => a.data.order - b.data.order);

const passos = [
  "Title much bigger and centred; one short line instead of the paragraph.",
  "Studio label in the inset rectangle from Set A (edge-to-edge tried and dropped).",
  "Thumb notch cut into the open end.",
  "Rotated small print: Hi-Fi, reading time and year.",
  "Light on the long folds and worn corners.",
];
---

<Base title="VHS lab — Vinicius Sato" description="VHS slipcase banner experiments.">
  <NavBar />

  <main class="container lab">
    <h1 class="lab__title">VHS lab</h1>
    <p class="lab__lead">Variations of the &ldquo;Next case&rdquo; banner, all three cases per set.</p>

    <section class="lab__set" aria-labelledby="set-a">
      <header class="lab__head">
        <p class="meta lab__tag">Set A</p>
        <h2 id="set-a">Current &mdash; live on the case pages</h2>
      </header>
      <div class="lab__stack">
        {cases.map((c) => <VhsBanner entry={c} />)}
      </div>
    </section>

    <section class="lab__set" aria-labelledby="set-b">
      <header class="lab__head">
        <p class="meta lab__tag">Set B</p>
        <h2 id="set-b">The five steps</h2>
        <ol class="lab__steps">
          {passos.map((p) => <li>{p}</li>)}
        </ol>
      </header>
      {/* No mobile vira estante: as fitas em pe, lado a lado. */}
      <VhsShelf cases={cases} />
    </section>
  </main>
</Base>

<style>
  .lab { padding-bottom: var(--space-6); }
  .lab__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
  }
  .lab__lead { margin-top: var(--space-1); font-family: var(--font-body); font-size: 1rem; color: #d1d1d1; }

  .lab__set { margin-top: var(--space-5); }
  .lab__head { margin-bottom: var(--space-3); }
  .lab__tag { color: var(--text-muted); }
  .lab__head h2 {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 600;
  }
  .lab__steps {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: #d1d1d1;
  }

  /* O host das fitas: abaixo de 700px de largura a VhsSpine entra na
     versao compacta. */
  .lab__stack { display: grid; gap: var(--space-3); container: spine-host / inline-size; }

</style>

<script>
  /* Painel do desgaste das fitas (DialKit). No laboratorio fica sempre
     aberto, sem precisar de ?calibrate. */
  const { mountWearPanel } = await import("../scripts/wear-panel");
  mountWearPanel();
</script>
