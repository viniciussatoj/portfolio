---
/* Laboratorio das lombadas VHS do "Next case". Cada set mostra os tres
   cases lado a lado com uma variacao, para comparar contra o banner que
   esta no ar. Fora do sitemap (astro.config) — e pagina de experimento. */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";
import VhsBanner from "../components/VhsBanner.astro";
import VhsSpine from "../components/VhsSpine.astro";

const cases = (await getCollection("cases", (c) => !c.data.draft)).sort((a, b) => a.data.order - b.data.order);

const passos = [
  "Title much bigger and centred; one short line instead of the paragraph.",
  "Studio label in the inset rectangle from Set A (edge-to-edge tried and dropped).",
  "Thumb notch cut into the open end.",
  "Rotated small print: Hi-Fi, reading time and year.",
  "Light on the long folds and worn corners.",
];
---

<Base title="VHS lab — Vinicius Sato" description="VHS slipcase banner experiments.">
  <NavBar />

  <main class="container lab">
    <h1 class="lab__title">VHS lab</h1>
    <p class="lab__lead">Variations of the &ldquo;Next case&rdquo; banner, all three cases per set.</p>

    <section class="lab__set" aria-labelledby="set-a">
      <header class="lab__head">
        <p class="meta lab__tag">Set A</p>
        <h2 id="set-a">Current &mdash; live on the case pages</h2>
      </header>
      <div class="lab__stack">
        {cases.map((c) => <VhsBanner entry={c} />)}
      </div>
    </section>

    <section class="lab__set" aria-labelledby="set-b">
      <header class="lab__head">
        <p class="meta lab__tag">Set B</p>
        <h2 id="set-b">The five steps</h2>
        <ol class="lab__steps">
          {passos.map((p) => <li>{p}</li>)}
        </ol>
      </header>
      {/* No mobile vira estante: as fitas em pe, lado a lado. */}
      <div class="lab__stack shelf">
        {cases.map((c) => (
          <div class="shelf__slot">
            <div class="shelf__spine"><VhsSpine entry={c} /></div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .lab { padding-bottom: var(--space-6); }
  .lab__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
  }
  .lab__lead { margin-top: var(--space-1); font-family: var(--font-body); font-size: 1rem; color: #d1d1d1; }

  .lab__set { margin-top: var(--space-5); }
  .lab__head { margin-bottom: var(--space-3); }
  .lab__tag { color: var(--text-muted); }
  .lab__head h2 {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 600;
  }
  .lab__steps {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: #d1d1d1;
  }

  /* O host das fitas: abaixo de 700px de largura a VhsSpine entra na
     versao compacta. */
  .lab__stack { display: grid; gap: var(--space-3); container: spine-host / inline-size; }

  /* ---------- estante (mobile) ----------
     Cada fita e desenhada no tamanho do desktop (1056 x 160) e girada 90
     graus: etiqueta em cima, furo e selo VHS embaixo. O --s e a escala
     que faz os 160 de espessura caberem na largura da coluna; vem do
     script abaixo. A fita girada e o host dela mesma, com 1056 de
     largura, entao a versao compacta nao entra. */
  /* As fitas do Set B encostam umas nas outras, como na prateleira. A
     estante e o olho: a perspectiva sai do centro dela, e e isso que faz
     cada fita puxada mostrar um lado diferente. Os embrulhos entre a
     estante e a fita precisam manter o 3D, senao achatam tudo. */
  .shelf {
    gap: 0;
    /* 800 com o puxao de 40 da fita: cresce uns 5% e mostra uns 4px de
       lado nas fitas de cima e de baixo. Menos perspectiva, mais lado. */
    perspective: 800px;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
  }
  .shelf__slot,
  .shelf__spine { transform-style: preserve-3d; }

  @media (max-width: 900px) {
    .shelf {
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }
    /* Ate 140 de espessura: em tablet, tres colunas largas dariam fitas
       de quase 2000px de altura. */
    .shelf__slot {
      flex: 0 1 140px;
      position: relative;
      aspect-ratio: 160 / 1056;
    }
    /* Dois nomes: spine-host (largura, para nao cair na compacta) e
       spine-shelf, que avisa a fita que ela esta em pe na estante. */
    .shelf__spine {
      container: spine-host spine-shelf / inline-size;
      position: absolute;
      top: 0;
      left: 0;
      width: 1056px;
      transform-origin: 0 0;
      /* Le-se da direita para a esquerda: escala, gira 90 em torno do
         canto, e empurra de volta para dentro da coluna. */
      transform: translateX(calc(var(--s, .76) * 160px)) rotate(90deg) scale(var(--s, .76));
    }
  }
</style>

<script>
  /* Escala da estante: espessura da coluna sobre os 160 da fita. */
  const ro = new ResizeObserver((entradas) => {
    for (const e of entradas) {
      (e.target as HTMLElement).style.setProperty("--s", String(e.contentRect.width / 160));
    }
  });
  document.querySelectorAll<HTMLElement>(".shelf__slot").forEach((el) => ro.observe(el));

  /* Painel do desgaste das fitas (DialKit). No laboratorio fica sempre
     aberto, sem precisar de ?calibrate. */
  const { mountWearPanel } = await import("../scripts/wear-panel");
  mountWearPanel();
</script>
