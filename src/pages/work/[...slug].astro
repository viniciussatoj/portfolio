---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import NavBar from "../../components/NavBar.astro";
import HeroMetrics from "../../components/blocks/HeroMetrics.astro";
import Lightbox from "../../components/Lightbox.astro";

export async function getStaticPaths() {
  const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    /* Proximo case pela ordem, voltando ao primeiro depois do ultimo —
       sem a volta o ultimo case terminaria sem saida. */
    props: { entry, proximo: cases[(i + 1) % cases.length] },
  }));
}

const { entry, proximo } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={`${data.title} — Vinicius Sato`} description={data.description} caseId={data.accent}>
  <NavBar showReturn />

  <main class="container case">
    <h1 class="case__title">{data.title}</h1>
    <p class="case__role">
      <strong>My role: {data.role}</strong> — {data.roleDetail}
    </p>

    <HeroMetrics
      brand={data.brand}
      metrics={data.metrics}
      src={data.heroImage}
      alt={data.heroAlt ?? ""}
    />

    <div class="case__body">
      <Content />
    </div>

    {/* Sem isto o case termina num paragrafo: quem leu ate o fim nao tem
        para onde ir. */}
    <nav class="next" aria-label="Keep exploring">
      <p class="meta next__label">Next case</p>
      <a class="next__card" href={`/work/${proximo.id}/`}>
        <span class="next__brand">{proximo.data.brand}</span>
        <span class="next__blurb">{proximo.data.blurb}</span>
        <span class="next__go">Read the case &rarr;</span>
      </a>
      <p class="next__talk">
        Curious about the decisions behind this work?{" "}
        <a href="https://www.linkedin.com/in/vinicius-satoj/" target="_blank" rel="noopener noreferrer"
          >Let&rsquo;s talk</a
        >.
      </p>
    </nav>
  </main>

  <Lightbox />
</Base>

<style>
  .case { padding-bottom: var(--space-6); }

  /* Base Neue Wide Bold Oblique com a aberracao cromatica do Figma.
     O peso e a inclinacao vem do arquivo, entao weight 400 e style
     normal — pedir 800/oblique faria o navegador sintetizar por cima,
     engordando e inclinando duas vezes. */
  .case__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-style: normal;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: 0.02em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--text-dim);
    text-shadow:
      0 0 4px rgb(255 184 0 / .35),
      1px 0 0 rgb(0 136 255 / .55),
      -1px -1px 0 rgb(255 56 60 / .55),
      0 2px 0 rgb(52 199 89 / .55);
  }

  /* spec: Hind Madurai 400/600, 20/28, tracking 0 */
  .case__role {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .case__role strong { font-weight: 600; }

  /* spec: Hind Madurai 400/600, 20/32, tracking 0, espaco entre paragrafos 16px */
  .case__body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0;
    color: #D1D1D1;
    /* O Figma pede coluna de 784 (1056 menos 136 de cada lado), que dava
       92 caracteres por linha — longe da faixa confortavel de 60 a 75.
       600px poe a media em 69 sem mexer no corpo da fonte. As figuras
       largas nao encolhem: o .bleed se mede por 50% do pai, entao elas
       seguem em 960 e so avancam mais sobre as margens. */
    max-width: 600px;
    margin: var(--space-4) auto;
  }
  .case__body :global(p) { margin-block: 0 var(--space-2); }
  .case__body :global(strong) { font-weight: 600; }

  /* Ritmo vertical: a fronteira de secao vale mais que a de item.
     Antes eram 32px entre secoes contra 48 entre itens numerados — a
     hierarquia lida pelo espaco estava invertida. A especificidade
     precisa dos tres niveis: o seletor do SectionTitle ja vale 0,2,0
     depois do atributo de escopo do Astro. */
  .case .case__body :global(.sectitle) { margin-top: clamp(64px, 9vw, 112px); }
  /* A primeira secao abre o corpo: o painel do hero ja separou. */
  .case .case__body > :global(.sectitle:first-child) { margin-top: 0; }

  /* A coluna estreita vale para o texto, nao para os blocos visuais: um
     Split de duas colunas dentro de 600px daria ~270px por mockup. Eles
     voltam para os 784 que a coluna tinha antes, pela mesma conta do
     .bleed. Quem ja tem .bleed (Row, Split de 3, figura wide) fica de
     fora, senao perderia os 960. No mobile nada disso se aplica: a
     largura vem da tela. */
  @media (min-width: 901px) {
    .case .case__body :global(.split:not(.bleed)),
    .case .case__body :global(.ba:not(.bleed)) {
      --bleed-w: min(784px, 100vw - 3rem);
      width: var(--bleed-w);
      margin-inline: calc(50% - var(--bleed-w) / 2);
    }
  }

  /* Ampliar: as figuras sao specs densos em ~300px e so servem
     ampliadas, mas nada dizia isso antes de o cursor mudar. A etiqueta
     usa a voz mono dos rotulos do site, fica visivel em repouso e firma
     no hover. pointer-events: none para o clique seguir chegando na
     imagem, que e quem abre o modal. */
  /* O data-zoom so existe nas imagens que o lightbox assumiu: com
     zoom={false}, ou sem JS, nao ha selo nem hover — o selo nunca
     promete uma acao que nao acontece. */
  .case .case__body :global(.fig) { position: relative; }
  .case .case__body :global(.fig:has(img[data-zoom]))::after {
    content: "Expand";
    position: absolute;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
    opacity: .8;
    transition: opacity .2s ease, background .2s ease, color .2s ease;
  }

  /* Com rotulo, o selo divide a linha dele: fica fora da imagem, onde
     nunca cobre a tela que esta sendo mostrada. */
  .case .case__body :global(.fig:has(img[data-zoom]):has(.fig__label))::after {
    top: 0;
    right: 0;
    color: var(--text-muted);
  }
  .case .case__body :global(.fig:has(img[data-zoom]):has(.fig__label):hover)::after {
    opacity: 1;
    color: var(--yellow);
  }

  /* Sem rotulo nao ha linha para dividir, entao ele sobrepoe — no alto,
     nao no pe, que e onde os mockups costumam ter o botao principal.
     Estas ganham legibilidade sobre qualquer fundo com a pastilha. */
  .case .case__body :global(.fig:has(img[data-zoom]):not(:has(.fig__label)))::after {
    top: 10px;
    right: 10px;
    color: #fff;
    background: rgb(0 0 0 / .55);
    border: 1px solid rgb(255 255 255 / .35);
    border-radius: 4px;
    padding: 4px 8px;
  }
  .case .case__body :global(.fig:has(img[data-zoom]):not(:has(.fig__label)):hover)::after {
    opacity: 1;
    background: rgb(0 0 0 / .8);
  }
  .case .case__body :global(.fig img) { transition: filter .2s ease; }
  .case .case__body :global(.fig:hover img[data-zoom]) { filter: brightness(1.08); }

  /* Fim de pagina, na mesma linguagem do painel do Overview: fio do
     accent sobre branco a 8%. */
  .next { max-width: 600px; margin: clamp(64px, 9vw, 112px) auto 0; }
  .next__label { color: var(--text-muted); margin-bottom: var(--space-2); }
  .next__card {
    display: grid;
    gap: var(--space-1);
    padding: 24px 20px;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: rgb(255 255 255 / .08);
    text-decoration: none;
    color: inherit;
    transition: background .2s ease, transform .2s ease;
  }
  .next__card:hover,
  .next__card:focus-visible { background: rgb(255 255 255 / .14); transform: translateY(-2px); }
  .next__brand {
    font-family: var(--font-display2);
    font-size: 1.5rem;
    line-height: 1.3333;
    color: var(--text);
  }
  .next__blurb { font-family: var(--font-body); font-size: 1rem; line-height: 1.5; color: #d1d1d1; }
  .next__go { font-family: var(--font-mono); font-size: var(--fs-meta); color: var(--yellow); }
  .next__talk {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: 1rem;
    color: #d1d1d1;
  }
  @media (max-width: 900px) {
    .case__title{

    }
    .case__body{
      font-size: 1.125rem;
      line-height: 1.6;
      margin : var(--space-2) var(--space-1);
    }
    /* No mobile a largura ja vem da tela; o teto de 600 so atrapalharia
       em telas entre 600 e 900. */
    .case__body, .next { max-width: none; }
    .next { margin-inline: var(--space-1); }
  }
</style>

<script>
  /* Rolagem vertical vira horizontal enquanto o carrossel passa. So no
     mobile e so para quem nao pediu menos movimento — import dinamico,
     entao quem nao entra nessa condicao nem baixa o codigo. */
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const { montarCarrosselPreso } = await import("../../scripts/carrossel-preso");
    montarCarrosselPreso();
  }
</script>
