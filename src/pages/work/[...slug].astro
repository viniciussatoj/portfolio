---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import NavBar from "../../components/NavBar.astro";
import HeroMetrics from "../../components/blocks/HeroMetrics.astro";
import Lightbox from "../../components/Lightbox.astro";
import VhsShelf from "../../components/VhsShelf.astro";

export async function getStaticPaths() {
  const todos = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
  /* Rascunhos ganham rota, mas nunca entram na estante do fim. */
  const publicados = todos.filter((c) => !c.data.draft);
  const rotas = todos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, publicados, claro: false },
  }));
  /* Previa em modo claro do V5, numa rota propria para comparar lado a
     lado: /work/liv-up-v5-light/. Mesmo conteudo, so os tokens trocados. */
  const v5 = todos.find((c) => c.id === "liv-up-v5");
  if (v5) rotas.push({ params: { slug: "liv-up-v5-light" }, props: { entry: v5, publicados, claro: true } });
  return rotas;
}

const { entry, publicados, claro } = Astro.props;

/* Tokens do modo claro (previa). Vai inline so na rota -light: um <style>
   com escopo entraria em todas as paginas de case. */
/* Paleta: fundo creme-rosado, texto vinho quase preto, e o vermelho da
   Liv Up em titulos, numeros, fios, faixas e paineis. Contrastes conferidos
   contra o fundo #FBF4F5: texto 15:1, corpo 11:1, apagado 6:1, vermelho
   #A3002F 8:1 e #C21045 5,6:1. */
const CLARO = `
  :root {
    --bg: #FBF4F5; --bg-raised: #FFFFFF;
    --text: #1E0810; --text-muted: #6B4552; --text-dim: #D9C3CA;
    --rule: #E8BFCB;
    --yellow: #A3002F; --yellow-glow: none;
    --accent-livup: #D98AA2; --accent-livup-hi: #C21045;
    --rule-strong: #C21045;
  }
  html, body { background: var(--bg) !important; color: var(--text); }

  /* Texto: titulos em vinho, corpo quase preto. */
  .case__title { color: #A3002F !important; text-shadow: none !important; }
  .sectitle { color: #1E0810 !important; text-shadow: none !important; }
  .case__body { color: #3B2129 !important; }
  .case__body strong { color: var(--text) !important; }
  .nav a, .nav__brand, .nav__links a, .nav__return { color: #A3002F !important; text-shadow: none !important; }

  /* Hero: o painel do Overview vira um cartao branco com fio vermelho. */
  .hero__panel { background: #FFFFFF !important; box-shadow: inset 0 0 0 1px #E8BFCB; }
  .hero__title { color: #A3002F !important; border-bottom-color: #E8BFCB !important; text-shadow: none !important; }
  .hero__role { color: #3B2129 !important; }

  /* Ficha do projeto: faixa rosada com os rotulos em vermelho. */
  .frow { background: #F7E1E8; border-color: #C21045 !important; padding-inline: 24px; }
  .frow__k { color: #A3002F !important; font-weight: 600 !important; }

  /* Destaques: barra vermelha sobre um fundo rosado. */
  .hl { background: #F7E1E8; padding: 20px 24px !important; border-left-width: 4px !important; }

  /* Telas: palco rosa mais cheio, sombra vinho. */
  .stage {
    background:
      radial-gradient(110% 70% at 50% 0%, rgb(194 16 69 / .28), transparent 70%),
      #F3D3DD !important;
  }
  .stage__img { filter: drop-shadow(0 22px 40px rgb(90 0 30 / .25)) !important; }
  .launch-screen__label { color: #6B4552 !important; }

  /* Cartoes e catalogo: branco com fio vermelho; titulos dos cartoes em
     vinho. */
  .cards__card { background: #FFFFFF !important; border-color: #D98AA2 !important; }
  .cards__h { color: #A3002F !important; }
  .cat__list { background: #FFFFFF !important; border-color: #C21045 !important; }
  .cat__item { border-bottom-color: #F0D6DE !important; }

  /* Numeros e resultados: a faixa de resultados vira um bloco vermelho
     cheio, com os numeros em branco. */
  .brow {
    background: #A3002F;
    border: 0 !important;
    border-radius: 12px;
    padding-inline: 32px !important;
  }
  .brow__n { color: #FFFFFF !important; }
  .brow__label { color: #F7D7E1 !important; }
  .meter__n, .beat__n, .spread__n { color: #C21045 !important; }

  /* Stepper: fio e pontos em vermelho. */
  .hl-line::before { background: #D98AA2 !important; }
  .hl-line__dot { background: var(--bg) !important; border-color: #C21045 !important; }
  .hl-line__step--hot .hl-line__dot { background: #C21045 !important; box-shadow: 0 0 14px rgb(194 16 69 / .45) !important; }

  /* Decisoes: numero e titulo em vinho. */
  .story__n, .pair__n { color: #C21045 !important; }
  .story__h, .pair__h, .num__h, .num__n { color: #A3002F !important; text-shadow: none !important; }

  /* Placeholders e rodape. */
  .ph__box { background: #FFFFFF !important; border-color: #C21045 !important; }
  .next__talk { color: #3B2129 !important; }
`;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={`${data.title} — Vinicius Sato`} description={data.description} caseId={data.accent}>
  {claro && <Fragment set:html={`<style>${CLARO}</style>`} />}
  <NavBar showReturn />

  <main class="container case">
    <h1 class="case__title">{data.title}</h1>
    <HeroMetrics
      brand={data.brand}
      role={data.role}
      roleDetail={data.roleDetail}
      tldr={data.tldr}
      src={data.heroImage}
      alt={data.heroAlt ?? ""}
    />

    <div class="case__body">
      <Content />
    </div>

    {/* Sem isto o case termina num paragrafo: quem leu ate o fim nao tem
        para onde ir. */}
    <nav class="next" aria-label="Keep exploring">
      <p class="meta next__label">More cases</p>
      {/* Todos os cases, como fitas na prateleira. O que esta sendo lido
          aparece alugado: escurecido e sem link. */}
      <VhsShelf cases={publicados} atual={entry.id} />
      <p class="next__talk">
        Curious about the decisions behind this work?{" "}
        <a href="https://www.linkedin.com/in/vinicius-satoj/" target="_blank" rel="noopener noreferrer"
          >Let&rsquo;s talk</a
        >.
      </p>
    </nav>
  </main>

  <Lightbox />
</Base>

<style>
  .case { padding-bottom: var(--space-6); }

  /* Base Neue Wide Bold Oblique com a aberracao cromatica do Figma.
     O peso e a inclinacao vem do arquivo, entao weight 400 e style
     normal — pedir 800/oblique faria o navegador sintetizar por cima,
     engordando e inclinando duas vezes. */
  .case__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-style: normal;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: 0.02em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--text-dim);
    text-shadow:
      0 0 4px rgb(255 184 0 / .35),
      1px 0 0 rgb(0 136 255 / .55),
      -1px -1px 0 rgb(255 56 60 / .55),
      0 2px 0 rgb(52 199 89 / .55);
  }

  /* Nos cases nao ha IBM Plex Mono: --font-mono e redefinido aqui como a
     fonte do corpo (Hind Madurai), e tudo que le essa variavel dentro do
     case (rotulos, legendas, cartoes) acompanha. A nav e a home ficam
     como estao. */
  .case { --font-mono: var(--font-body); }

  /* spec: Hind Madurai 400/600, 20/32, tracking 0, espaco entre paragrafos 16px */
  .case__body {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    letter-spacing: 0;
    color: #D1D1D1;
    /* Corpo na largura do container, a mesma do hero. Em troca a linha
       vai a ~120 caracteres, bem acima da faixa confortavel de 60 a 75:
       o texto corrido fica longo de ler, e quem ganha sao os blocos de
       duas colunas, que passam a ter largura de sobra.

       As figuras largas nao mudam de tamanho: o .bleed se mede por 50%
       do pai, entao ele se recentra sozinho seja qual for essa largura. */
    margin: var(--space-4) auto;
  }
  .case__body :global(p) { margin-block: 0 var(--space-2); }
  /* Negrito em branco puro, um degrau acima do #D1D1D1 do corpo. Vale
     tambem para os blocos dentro do corpo (PullQuote, CategoryList...). */
  .case__body :global(strong) { font-weight: 600; color: #ffffff; }
  /* Fio entre itens de uma secao (Hubees v2): 32 de cada lado, no accent. */
  .case__body :global(hr) {
    border: 0;
    border-top: 1px solid var(--accent);
    margin-block: var(--space-3);
  }

  /* Ritmo vertical: a fronteira de secao vale mais que a de item.
     Antes eram 32px entre secoes contra 48 entre itens numerados — a
     hierarquia lida pelo espaco estava invertida. A especificidade
     precisa dos tres niveis: o seletor do SectionTitle ja vale 0,2,0
     depois do atributo de escopo do Astro. */
  .case .case__body :global(.sectitle) { margin-top: clamp(64px, 9vw, 112px); }
  /* A primeira secao abre o corpo: o painel do hero ja separou. */
  .case .case__body > :global(.sectitle:first-child),
  .case .case__body > :global(.aside:first-child .aside__main > .sectitle:first-child) { margin-top: 0; }

  /* Aside que abre com titulo de secao: a margem passa do titulo para o
     bloco inteiro. Deixada no titulo, ela empurrava so a coluna da
     esquerda, e o texto comecava mais baixo que o painel — as duas
     colunas da mesma secao nascendo em alturas diferentes. Agora o
     espaco fica antes do conjunto e os dois topos coincidem. */
  .case .case__body :global(.aside:not(:first-child):has(.aside__main > .sectitle:first-child)) {
    margin-top: clamp(64px, 9vw, 112px);
  }
  .case .case__body :global(.aside .aside__main > .sectitle:first-child) { margin-top: 0; }
  /* No StackScroll preso o titulo fica dentro da caixa que gruda na tela;
     o respiro de secao sai dele e vai para fora, senao a caixa presa
     carregaria 112px de vazio no topo. */
  /* Embaixo, 16 mais os 16 do row-gap da grade: os 32 do Figma. */
  .case .case__body :global(.stk--on .stk__title .sectitle) { margin-block: 0 var(--space-2); }
  .case .case__body :global(.stk--on) { margin-top: clamp(64px, 9vw, 112px); }

  /* A coluna estreita vale para o texto, nao para os blocos visuais: o
     BeforeAfter volta para os 784 que a coluna tinha antes, pela mesma
     conta do .bleed. Quem ja tem .bleed (Row, figura wide) fica de fora,
     senao perderia os 960. No mobile nada disso se aplica: a largura vem
     da tela. */
  @media (min-width: 901px) {
    .case .case__body :global(.ba:not(.bleed)) {
      --bleed-w: min(784px, 100vw - 3rem);
      width: var(--bleed-w);
      margin-inline: calc(50% - var(--bleed-w) / 2);
    }
  }

  /* Ampliar: as figuras sao specs densos em ~300px e so servem
     ampliadas, mas nada dizia isso antes de o cursor mudar. A etiqueta
     usa a voz mono dos rotulos do site, fica visivel em repouso e firma
     no hover. pointer-events: none para o clique seguir chegando na
     imagem, que e quem abre o modal. */
  /* O data-zoom so existe nas imagens que o lightbox assumiu: com
     zoom={false}, ou sem JS, nao ha selo nem hover — o selo nunca
     promete uma acao que nao acontece. */
  .case .case__body :global(.fig) { position: relative; }
  .case .case__body :global(.fig:has(img[data-zoom]))::after {
    content: "Expand";
    position: absolute;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: none;
    opacity: .8;
    transition: opacity .2s ease, background .2s ease, color .2s ease;
  }

  /* Com rotulo, o selo divide a linha dele: fica fora da imagem, onde
     nunca cobre a tela que esta sendo mostrada. */
  .case .case__body :global(.fig:has(img[data-zoom]):has(.fig__label))::after {
    top: 0;
    right: 0;
    color: var(--text-muted);
  }
  .case .case__body :global(.fig:has(img[data-zoom]):has(.fig__label):hover)::after {
    opacity: 1;
    color: var(--yellow);
  }

  /* Sem rotulo nao ha linha para dividir, entao ele sobrepoe — no alto,
     nao no pe, que e onde os mockups costumam ter o botao principal.
     Estas ganham legibilidade sobre qualquer fundo com a pastilha. */
  .case .case__body :global(.fig:has(img[data-zoom]):not(:has(.fig__label)))::after {
    top: 10px;
    right: 10px;
    color: #fff;
    background: rgb(0 0 0 / .55);
    border: 1px solid rgb(255 255 255 / .35);
    border-radius: 4px;
    padding: 4px 8px;
  }
  .case .case__body :global(.fig:has(img[data-zoom]):not(:has(.fig__label)):hover)::after {
    opacity: 1;
    background: rgb(0 0 0 / .8);
  }
  .case .case__body :global(.fig img) { transition: filter .2s ease; }
  .case .case__body :global(.fig:hover img[data-zoom]) { filter: brightness(1.08); }

  /* Fim de pagina, na mesma linguagem do painel do Overview: fio do
     accent sobre branco a 8%. */
  .next { max-width: var(--container); margin: clamp(64px, 9vw, 112px) auto 0; }
  .next__label { color: var(--text-muted); margin-bottom: var(--space-2); }
  .next__talk {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: 1rem;
    color: #d1d1d1;
  }
  @media (max-width: 900px) {
    .case__title{

    }
    .case__body{
      font-size: 1.125rem;
      line-height: 1.6;
      margin : var(--space-2) var(--space-1);
    }
    /* No mobile a largura ja vem da tela; o teto de 600 so atrapalharia
       em telas entre 600 e 900. */
    .case__body, .next { max-width: none; }
    .next { margin-inline: var(--space-1); }
  }
</style>


<script>
  /* As barras dos titulos de secao enchem com a rolagem, em pixel art.
     O painel de calibragem entra so com ?calibrate, num chunk a parte. */
  const { montarBarras } = await import("../../scripts/barra");
  const barras = montarBarras();

  if (new URLSearchParams(location.search).has("calibrate")) {
    const [{ montarPainel }, { ajustesDoCaso }] = await Promise.all([
      import("../../scripts/dither-progress-panel"),
      import("../../scripts/dither-config"),
    ]);
    const caso = document.body.dataset.case;
    montarPainel(barras.aplicar, { id: "barras-secoes", padrao: ajustesDoCaso(caso), caso });
  }
</script>
