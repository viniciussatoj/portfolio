---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import NavBar from "../../components/NavBar.astro";
import HeroMetrics from "../../components/blocks/HeroMetrics.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={`${data.title} — Vinicius Sato`} description={data.description} caseId={data.accent}>
  <NavBar showReturn />

  <main class="container case">
    <h1 class="case__title">{data.title}</h1>
    <p class="case__role">
      <strong>My role: {data.role}</strong> — {data.roleDetail}
    </p>

    <HeroMetrics brand={data.brand} metrics={data.metrics} src={data.heroImage} alt="" />

    <div class="case__body">
      <Content />
    </div>
  </main>
</Base>

<style>
  .case { padding-bottom: var(--space-6); }

  /* Base Neue Wide Bold Oblique com a aberracao cromatica do Figma.
     O peso e a inclinacao vem do arquivo, entao weight 400 e style
     normal — pedir 800/oblique faria o navegador sintetizar por cima,
     engordando e inclinando duas vezes. */
  .case__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-style: normal;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: 0.02em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--text-dim);
    text-shadow:
      0 0 4px rgb(255 184 0 / .35),
      1px 0 0 rgb(0 136 255 / .55),
      -1px -1px 0 rgb(255 56 60 / .55),
      0 2px 0 rgb(52 199 89 / .55);
  }

  /* spec: Hind Madurai 400/600, 20/28, tracking 0 */
  .case__role {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .case__role strong { font-weight: 600; }

  /* spec: Hind Madurai 400/600, 20/32, tracking 0, espaco entre paragrafos 16px */
  .case__body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0;
    color: #D1D1D1; 
    /* Figma: coluna de 784 dentro dos 1056 = 136px de cada lado. */
    margin: var(--space-4) 136px;
  }
  .case__body :global(p) { margin-block: 0 var(--space-2); }
  .case__body :global(strong) { font-weight: 600; }
  @media (max-width: 900px) {
    .case__title{

    }
    .case__body{
      font-size: 1.125rem;
      line-height: 1.6;
      margin : var(--space-2) var(--space-1);
    }
  }
</style>
