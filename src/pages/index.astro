---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";

// Fonte unica de verdade: src/content/cases/*.mdx
const works = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Vinicius Sato — Product Designer"
  description="Product Designer with 8 years of experience, working end-to-end and bringing everyone along for the ride."
>
  <NavBar />

  <main>
    <h1 class="container display">
      Product Designer with 8 years of experience, working end-to-end and
      bringing everyone along for the ride.
    </h1>

    <section class="container works" aria-labelledby="works-label">
      <h2 id="works-label" class="works__label">What I&rsquo;ve worked on so far</h2>

      <div class="works__row">
        {works.map((w, i) => (
          <a
            class={`card card--${w.data.accent}`}
            data-case={w.data.accent}
            href={`/work/${w.id}/`}
            style={`--i:${i}`}
          >
            {/* TODO: trocar pelo logo exportado do Figma — nao inventar vetor */}
            <span class="card__brand">{w.data.brand}</span>
            <dl class="card__metrics">
              {w.data.metrics.filter((m) => m.onHome).map((m) => (
                <div class="card__metric">
                  <dt>{m.k}</dt>
                  <dd>{m.v}</dd>
                </div>
              ))}
            </dl>
          </a>
        ))}
      </div>

      <div class="works__meta">
        {works.map((w) => (
          <div class={`workmeta workmeta--${w.data.accent}`}>
            <p class="meta workmeta__cat">{w.data.category}</p>
            <p class="workmeta__blurb">{w.data.blurb}</p>
            <p class="meta workmeta__year">{w.data.year}</p>
            <p class="meta workmeta__tags">{w.data.tags}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .display {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: 400;
    letter-spacing: -0.01em;
    /* Figma: 1056x192 = 3 linhas. Sem max-width extra — a medida e o container. */
    /* Figma: headline termina em y=371,8 e o label comeca em y=436 = 64px. */
    padding-bottom: 4rem;
  }

  /* Mesmo tratamento da nav: Plex Sans 20px/500, caixa alta.
     Nao usa a classe .meta — o mono e so para o texto dos cards. */
  .works__label {
    font-size: var(--fs-lead);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--yellow);
    text-shadow: var(--yellow-glow);
    margin-bottom: var(--space-3);
  }

  /* Faixa dos cards: 1056x283 no Figma. Os cards sao posicionados em
     absoluto para que o ativo cresca SOBRE os vizinhos, sem empurra-los —
     que e como o Figma resolveu o hover. */
  .works__row { position: relative; aspect-ratio: 1056 / 283; }

  .card {
    --w: calc((100% - 2 * var(--gutter)) / 3);
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--i) * (var(--w) + var(--gutter)));
    width: var(--w);

    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius);
    overflow: hidden;

    /* Em repouso o card ja mostra seu accent — nao e cinza. Os cards
       nao-ativos escurecem via filter quando outro recebe hover. */
    background: radial-gradient(120% 160% at 30% 20%, var(--accent-hi), var(--accent) 70%);
    color: var(--text);
    text-decoration: none;
    text-shadow: none;

    transition:
      left var(--dur) var(--ease),
      width var(--dur) var(--ease),
      filter var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .card:hover,
  .card:focus-visible { left: 0; width: 100%; z-index: 2; }

  /* Com um card ativo, os demais recuam. */
  .works:has(.card:hover, .card:focus-visible) .card { filter: brightness(.22) saturate(.5); }
  .works:has(.card:hover, .card:focus-visible) .card:hover,
  .works:has(.card:hover, .card:focus-visible) .card:focus-visible { filter: none; }

  .card__brand {
    flex: 0 0 auto;
    font-size: var(--fs-lead);
    font-weight: 600;
    white-space: nowrap;
  }
  .card:hover .card__brand,
  .card:focus-visible .card__brand { flex-basis: 186px; text-align: center; font-size: 2rem; }

  /* As metricas so existem no estado expandido. */
  .card__metrics {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    min-width: 0;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .card:hover .card__metrics,
  .card:focus-visible .card__metrics { opacity: 1; }

  .card__metric dt { font-size: var(--fs-metric); font-weight: 600; line-height: var(--lh-tight); }
  .card__metric dd { margin: 0; font-size: var(--fs-meta); opacity: .9; }

  /* Texto abaixo: acende junto com o card correspondente. */
  /* subgrid: as quatro faixas (categoria, descricao, ano, tags) viram
     trilhas compartilhadas pelas tres colunas. Cada trilha se dimensiona
     pela coluna mais alta, entao o ano fica no mesmo eixo mesmo quando
     uma descricao ocupa uma linha a mais. Gap zero — o respiro vem das
     margens dos filhos, que e como o Figma espaca. */
  .works__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, auto);
    column-gap: var(--gutter);
    row-gap: 0;
    margin-top: var(--space-3);
  }

  /* Em repouso os tres blocos ficam ACESOS — so a categoria e mais
     apagada, por hierarquia. Apagar tudo em idle estava invertido. */
  /* Coluna flex: o grid estica todas a altura da mais alta, e o bloco
     de ano e empurrado para a base. Assim ano e tags ficam alinhados
     entre as tres colunas mesmo se uma descricao ocupar uma linha a
     mais — que e o que o Figma consegue com o slot fixo em y=148. */
  .workmeta { display: grid; grid-row: span 4; grid-template-rows: subgrid; color: var(--text); transition: color var(--dur) var(--ease); }
  .workmeta__cat { text-transform: uppercase; color: var(--text-muted); transition: color var(--dur) var(--ease); }
  /* Figma: 20px / 28px. O no do texto mede 330x84 = 3 linhas de 28. */
  .workmeta__blurb {
    margin-block: var(--space-2);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }
  .workmeta__year { margin-top: var(--space-2); }

  /* Com um card em hover, os OUTROS e que apagam. */
  .works:has(.card:hover, .card:focus-visible) .workmeta,
  .works:has(.card:hover, .card:focus-visible) .workmeta__cat { color: var(--text-dim); }

  .works:has(.card--livup:hover, .card--livup:focus-visible) .workmeta--livup,
  .works:has(.card--investai:hover, .card--investai:focus-visible) .workmeta--investai,
  .works:has(.card--hubees:hover, .card--hubees:focus-visible) .workmeta--hubees { color: var(--text); }

  .works:has(.card--livup:hover, .card--livup:focus-visible) .workmeta--livup .workmeta__cat,
  .works:has(.card--investai:hover, .card--investai:focus-visible) .workmeta--investai .workmeta__cat,
  .works:has(.card--hubees:hover, .card--hubees:focus-visible) .workmeta--hubees .workmeta__cat { color: var(--text-muted); }

  /* Sem hover em toque: tudo empilhado e aberto. */
  @media (max-width: 900px) {
    .display { font-size: 1.75rem; padding-bottom: var(--space-4); }
    .works__row { aspect-ratio: auto; display: grid; gap: var(--space-3); }
    .card {
      position: static;
      width: auto;
      flex-direction: column;
      align-items: flex-start;
    }
    .card__brand { font-size: 1.5rem; }
    .card__metrics { opacity: 1; }
    .works__meta { grid-template-columns: 1fr; grid-template-rows: none; row-gap: var(--space-4); }
    .workmeta { display: block; }
    .workmeta { color: var(--text); }
  }
</style>
