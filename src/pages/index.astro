---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";
import { Image } from "astro:assets";

// Os logos vivem em src/assets para passar pelo pipeline. O glob evita
// um import nomeado por marca — a chave e o id do case.
const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/logos/*.png", { eager: true });
const logoDe = (id: string) => logos[`../assets/logos/${id}.png`].default;

// O data-text alimenta as copias do glitch (::before/::after), entao a
// frase precisa existir uma vez so.
const headline =
  "Product Designer with 8 years of experience, working end-to-end and bringing everyone along for the ride.";

// Fonte unica de verdade: src/content/cases/*.mdx
const works = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Vinicius Sato — Product Designer"
  description="Product Designer with 8 years of experience, working end-to-end and bringing everyone along for the ride."
>
  <NavBar />

  <main>
    <h1 class="container display" data-text={headline}>{headline}</h1>

    <section class="container works" aria-labelledby="works-label">
      <h2 id="works-label" class="works__label">What I&rsquo;ve worked on so far</h2>

      <div class="works__grid">
        {works.map((w, i) => (
          <article
            class={`work work--${w.data.accent}`}
            data-case={w.data.accent}
            style={`--i:${i}; --col:${i + 1}`}
          >
            {/* Reserva a altura da faixa no desktop — o .card sai do fluxo
                para poder crescer por cima dos vizinhos. */}
            <div class="card__slot" aria-hidden="true"></div>

            <a
              class="card"
              href={`/work/${w.id}/`}
              aria-label={`${w.data.brand} case study`}
              data-brand={w.data.brand}
            >
              {/* Efeito CRT. Fica vazio ate o WebGL ligar — se nao ligar, o
                  card CSS por baixo continua sendo o visual. */}
              <canvas class="card__crt" aria-hidden="true"></canvas>
              {/* Decorativo: o <a> ja carrega o nome no aria-label. */}
              <span class="card__logo">
                <Image src={logoDe(w.id)} alt="" loading="eager" />
              </span>
              <dl class="card__metrics">
                {w.data.metrics.filter((m) => m.onHome).map((m) => (
                  <div class="card__metric">
                    <dt>{m.k}</dt>
                    <dd>{m.v}</dd>
                  </div>
                ))}
              </dl>
            </a>

            <p class="workmeta__cat">{w.data.category}</p>
            <p class="workmeta__blurb">{w.data.blurb}</p>
            <p class="workmeta__year">{w.data.year}</p>
            <p class="workmeta__tags">{w.data.tags}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  /* Figma 269:1626 — Abduction2002 regular, 48/64, tracking 0.96px, e a
     aberracao cromatica em text-shadow. O obliquo e a caixa alta vem do
     desenho da fonte, nao de CSS: por isso font-style normal e sem
     text-transform. */
  .display {
    /* Figma 282:2239 — Base Neue Wide Bold Oblique 48/64, tracking 0.
       O peso e a inclinacao vem do arquivo da fonte, entao weight 400 e
       style normal: pedir 800/oblique faz o navegador sintetizar por
       cima, engordando e inclinando duas vezes. */
    font-family: var(--font-display2);
    font-weight: 400;
    font-style: normal;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: 0;
    color: var(--text);
    /* Figma: headline em y=210 com 256 de altura, label em y=546. */
    padding-bottom: 5rem;

    /* Dirigido por JS: --g e a intensidade 0..1, o resto sao os offsets
       ja multiplicados por ela. Sem JS ficam em 0 e o titulo aparece com
       a aberracao estatica do Figma. */
    --g: 0;
    --ab: 0px;
    --shake: 0px;
    position: relative;
    translate: var(--shake) 0;
    /* A aberracao base do Figma cresce com a intensidade. */
    text-shadow:
      /*0 0 4px rgb(255 184 0 / .8),*/
      calc(1px + var(--g) * var(--ab)) 0 0 rgb(0 136 255 / .6),
      calc(-1px - var(--g) * var(--ab)) -1px 0 rgb(255 56 60 / .6),
      0 2px 0 rgb(52 199 89 / .6);
  }

  /* Copias recortadas em faixas: e o que produz o corte horizontal.
     aria-hidden por serem duplicatas — o leitor de tela le so o h1. */
  .display[data-glitch="on"]::before,
  .display[data-glitch="on"]::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    text-shadow: none;
    mix-blend-mode: screen;
  }
  .display[data-glitch="on"]::before {
    color: rgb(0 136 255 / .85);
    clip-path: inset(var(--s0-top, 50%) 0 var(--s0-bot, 50%) 0);
    translate: var(--s0-x, 0px) 0;
  }
  .display[data-glitch="on"]::after {
    color: rgb(255 56 60 / .85);
    clip-path: inset(var(--s1-top, 50%) 0 var(--s1-bot, 50%) 0);
    translate: var(--s1-x, 0px) 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .display::before,
    .display::after { display: none; }
  }

  /* Mesmo tratamento da nav: Plex Sans 20px/500, caixa alta. */
  .works__label {
    font-size: var(--fs-lead);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--yellow);
    text-shadow: var(--yellow-glow);
    margin-bottom: var(--space-3);
  }

  /* ---------- desktop ----------
     Um grid unico: linha 1 = faixa dos cards, linhas 2..5 = as quatro
     faixas de texto. Cada <article> usa display:contents, entao seus
     filhos caem direto nas trilhas do grid e o alinhamento entre as
     colunas se mantem sozinho, qualquer que seja o tamanho da copy. */
  .works__grid {
    position: relative;
    /* container query: permite exprimir a altura do card em funcao da
       LARGURA da faixa. Com 100% nao da — em elemento absoluto, height
       resolve contra a altura do bloco contentor. */
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto auto auto;
    column-gap: var(--gutter);
    row-gap: 0;
  }

  .work { display: contents; }

  .card__slot { grid-column: var(--col); grid-row: 1; aspect-ratio: 330.66668 / 283; }

  .card {
    --w: calc((100cqw - 2 * var(--gutter)) / 3);
    position: absolute;
    top: 0;
    left: calc(var(--i) * (var(--w) + var(--gutter)));
    width: var(--w);
    height: calc(var(--w) * 283 / 330.66668);

    display: flex;
    align-items: center;
    gap: var(--space-4);
    /* Sem padding em repouso — assim os percentuais do logo resolvem
       contra o card inteiro, que e como o Figma dimensiona. */
    padding: 0;
    border-radius: var(--radius);
    overflow: hidden;

    /* Em repouso o card ja mostra seu accent — nao e cinza. */
    background: radial-gradient(120% 160% at 30% 20%, var(--accent-hi), var(--accent) 70%);
    color: var(--text);
    text-decoration: none;
    text-shadow: none;

    transition:
      left var(--dur) var(--ease),
      width var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }


  /* Figma: o logo ocupa 186x186 no Liv Up, 271x94 no Hubees e 262x86 no
     InvestAI. Com contain, 80%/66% reproduz os tres sem regra por marca. */
  /* Flex, nao grid: a trilha automatica do grid cresce para o conteudo e
     transborda a caixa quando o card e baixo — o logo desce e o max-height %
     passa a resolver contra a trilha em vez da caixa. */
  .card__logo { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; min-width: 0; height: 100%; }
  .card__logo img { max-width: 80%; max-height: 66%; width: auto; height: auto; object-fit: contain; }

  /* O canvas cobre o card e desenha fundo + logo. So aparece quando o
     WebGL inicializa, entao o CSS abaixo dele e o fallback. */
  .card__crt {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    /* border-radius sozinho nao basta: o canvas WebGL ganha camada propria
       de composicao e ignora o recorte do pai. clip-path recorta de fato. */
    clip-path: inset(0 round var(--radius));
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
    pointer-events: none;
  }
  .card__crt[data-crt="on"] { opacity: 1; }

  /* Conteudo acima do canvas. */
  .card__logo, .card__metrics { position: relative; z-index: 1; }

  /* Com o efeito ligado o logo em repouso vem do shader; o do CSS so
     reaparece no hover, quando o card expande e ele vai para a esquerda. */
  .card[data-crt="on"] .card__logo { opacity: 0; transition: opacity var(--dur) var(--ease); }

  .card__metrics {
    gap: var(--space-2);
    margin: 0;
    min-width: 0;
    display: none;
  }
  .card__metric dt { font-size: var(--fs-metric); font-weight: 600; line-height: var(--lh-tight); }
  .card__metric dd { margin: 0; font-size: var(--fs-meta); opacity: .9; }

  /* ---------- texto sob os cards ---------- */
  .workmeta__cat,
  .workmeta__blurb,
  .workmeta__year,
  .workmeta__tags { grid-column: var(--col); margin: 0; transition: color var(--dur) var(--ease); }

  .workmeta__cat {
    grid-row: 2;
    /* Figma: card termina em 283 e o texto comeca em 299 = 16px. */
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* Preserva a quebra de linha vinda do frontmatter (bloco YAML |-),
       sem transformar o campo em HTML. */
    white-space: pre-line;
  }
  /* Figma: 20px / 28px. O no do texto mede 330x84 = 3 linhas de 28. */
  .workmeta__blurb { grid-row: 3; margin-block: var(--space-2); font-size: var(--fs-lead); line-height: 1.4; }
  .workmeta__year { grid-row: 4; margin-top: var(--space-2); font-family: var(--font-mono); font-size: var(--fs-meta); font-weight: 600; }
  .workmeta__tags { grid-row: 5; font-family: var(--font-mono); font-size: var(--fs-meta); letter-spacing: .04em; }


  /* ---------- estado ativo: so desktop com mouse ----------
     Todo o comportamento de hover/foco do card fica aqui dentro. No toque
     o :hover gruda depois do tap, o card expande sobre o layout empilhado
     do mobile e quebra a pagina — entao fora deste media query o card nao
     tem estado ativo nenhum e o toque so segue o link. hover: hover exclui
     telas de toque de qualquer largura; min-width cobre a janela estreita
     no desktop, onde o layout ja e o empilhado. */
  @media (hover: hover) and (min-width: 901px) {
    .card:hover,
    .card:focus-visible { left: 0; width: 100cqw; z-index: 2; padding: var(--space-3); }

    /* Com um card ativo, os demais recuam. */
    .works__grid:has(.card:hover, .card:focus-visible) .card { filter: brightness(.22) saturate(.5); }
    .works__grid:has(.card:hover, .card:focus-visible) .card:hover,
    .works__grid:has(.card:hover, .card:focus-visible) .card:focus-visible { filter: none; }

    .card:hover .card__logo,
    .card:focus-visible .card__logo { flex: 0 0 186px; }
    .card:hover .card__logo img,
    .card:focus-visible .card__logo img { max-width: 100%; max-height: 80%; }

    .card[data-crt="on"]:hover .card__logo,
    .card[data-crt="on"]:focus-visible .card__logo { opacity: 1; }

    .card:hover .card__metrics,
    .card:focus-visible .card__metrics { display: grid; }

    /* Com um card ativo, o texto dos outros recua junto. */
    .works__grid:has(.card:hover, .card:focus-visible) .workmeta__cat,
    .works__grid:has(.card:hover, .card:focus-visible) .workmeta__blurb,
    .works__grid:has(.card:hover, .card:focus-visible) .workmeta__year,
    .works__grid:has(.card:hover, .card:focus-visible) .workmeta__tags { color: var(--text-dim); }

    .work:has(.card:hover, .card:focus-visible) .workmeta__blurb,
    .work:has(.card:hover, .card:focus-visible) .workmeta__year,
    .work:has(.card:hover, .card:focus-visible) .workmeta__tags { color: var(--text); }
    .work:has(.card:hover, .card:focus-visible) .workmeta__cat { color: var(--text-muted); }
  }

  /* ---------- mobile (referencia: 414px) ----------
     Sem hover: cada case vira um bloco empilhado, com card e texto
     intercalados. As metricas nao aparecem — elas vivem no case. */
  @media (max-width: 900px) {
    .display { font-size: 2rem; font-weight: 500; line-height: 1.5; padding-bottom: var(--space-4); }
    .works__label { font-size: 1rem; margin-bottom: var(--space-3); }

    .works__grid { display: flex; flex-direction: column; gap: var(--space-5); }
    .work { display: block; }

    .card__slot { display: none; }

    .card {
      /* relative, nao static: o canvas e absolute e sem isso se ancora no
         .works__grid, cobrindo a coluna inteira. Com relative o left do
         desktop volta a valer, entao precisa ser zerado aqui. */
      position: relative;
      left: 0;
      width: auto;
      height: 240px;
      justify-content: center;
      padding: 0;
      filter: none;
    }
    .card__logo img { max-width: 70%; max-height: 70%; }
    .card__metrics { display: none; }

    .workmeta__cat { margin-top: var(--space-3); }
    .workmeta__blurb { font-size: 1.125rem; line-height: 1.45; margin-block: var(--space-2); }
    .workmeta__year { margin-top: var(--space-2); }
  }
</style>

<script>
  import { mount, type Instance } from "../scripts/crt";
  import { VIGNETTE } from "../scripts/crt-config";

  type T = { id: string; brand: string; instance: Instance; hi: string; lo: string };
  const alvos: T[] = [];

  for (const card of document.querySelectorAll<HTMLAnchorElement>(".card")) {
    const canvas = card.querySelector<HTMLCanvasElement>(".card__crt");
    const img = card.querySelector<HTMLImageElement>("img");
    if (!canvas || !img) continue;

    // A textura precisa dos pixels. decode() sozinho nao basta: se a
    // imagem for lazy e ainda nao tiver comecado, ele rejeita.
    if (!img.complete || img.naturalWidth === 0) {
      img.loading = "eager";
      const ok = await new Promise<boolean>((res) => {
        if (img.complete && img.naturalWidth > 0) return res(true);
        img.addEventListener("load", () => res(true), { once: true });
        img.addEventListener("error", () => res(false), { once: true });
        setTimeout(() => res(img.naturalWidth > 0), 3000);
      });
      if (!ok) { console.warn("[crt] logo nao carregou, mantendo fallback:", img.currentSrc); continue; }
    }

    const instance = mount(canvas, img);
    if (!instance) continue;
    card.dataset.crt = "on";

    // A vinheta calibrada vale para todo visitante. Antes so era aplicada
    // dentro do bloco ?calibrate, entao o site publicado puxava para preto.
    instance.setVignetteColor(VIGNETTE);

    const cs = getComputedStyle(card);
    // data-case fica no <article>, nao no <a> — sem o closest o id vinha
    // vazio e os tres cards colidiam na mesma chave de armazenamento.
    const id = card.closest<HTMLElement>(".work")?.dataset.case ?? "";
    const hi = cs.getPropertyValue("--accent-hi").trim() || "#d22047";
    const lo = cs.getPropertyValue("--accent").trim() || "#890029";
    instance.setColors(hi, lo);

    // no hover quem mostra o logo e o CSS, nao o shader. Mesma condicao do
    // media query do estado ativo: no toque o card nao expande, entao o
    // shader continua desenhando o logo.
    const expande = () => matchMedia("(hover: hover) and (min-width: 901px)").matches;
    card.addEventListener("pointerenter", () => { if (expande()) instance.setLogoVisible(false); });
    card.addEventListener("pointerleave", () => instance.setLogoVisible(true));
    card.addEventListener("focus", () => { if (expande()) instance.setLogoVisible(false); });
    card.addEventListener("blur", () => instance.setLogoVisible(true));

    alvos.push({ id, brand: card.dataset.brand ?? id, instance, hi, lo });
  }

  // Glitch do headline: CSS puro dirigido por custom properties, o texto
  // continua sendo texto.
  const titulo = document.querySelector<HTMLElement>(".display");
  if (titulo) {
    const { mountCssGlitch } = await import("../scripts/css-glitch");
    mountCssGlitch(titulo, "title");
  }

  // Painel de calibragem: import dinamico, so com ?calibrate na URL.
  // Visitante normal nao baixa esse chunk.
  if (alvos.length && new URLSearchParams(location.search).has("calibrate")) {
    const { mountPanel, loadColors, loadVignette } = await import("../scripts/crt-panel");
    const salvas = loadColors();
    const vinheta = loadVignette();
    for (const a of alvos) a.instance.setVignetteColor(vinheta);
    for (const a of alvos) {
      const c = salvas[a.id];
      if (c) { a.hi = c.hi; a.lo = c.lo; a.instance.setColors(c.hi, c.lo); }
    }
    mountPanel(alvos);
  }
</script>
