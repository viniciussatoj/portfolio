---
import "../styles/global.css";
import { noiseDaPagina, noiseUrl } from "../scripts/noise-config";

interface Props {
  title: string;
  description: string;
  caseId?: "livup" | "investai" | "hubees";
}

const { title, description, caseId } = Astro.props;
/* Noise do fundo: o ladrilho sai pronto no HTML, sem JS. O painel do
   ?calibrate so reescreve estas duas variaveis. */
const noiseCfg = noiseDaPagina(caseId);
const noise = `--noise-img: ${noiseUrl(noiseCfg)}; --noise-opacity: ${noiseCfg.ligado ? noiseCfg.intensidade : 0}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://viniciussato.com");
---

<!doctype html>
<html lang="en" style={noise}>
  <head>
    <meta charset="utf-8" />
    {/* Transicao do noise entre paginas: guarda o noise desta pagina na
        sessao e, se a anterior tinha outro (o grao muda de cor por case),
        deixa o antigo em --noise-prev para o CSS desfazer devagar. Inline
        e no head para rodar antes da primeira pintura, sem piscar. */}
    <script is:inline>
      try {
        const html = document.documentElement;
        const atual = html.style.getPropertyValue("--noise-img");
        const antes = sessionStorage.getItem("noise-img");
        if (antes && antes !== atual) {
          html.style.setProperty("--noise-prev", antes);
          html.dataset.noiseFrom = "";
        }
        sessionStorage.setItem("noise-img", atual);
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Gerados de src/assets/brand/favicon-source.png. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body data-case={caseId}>
    <slot />

    <script>
      /* InterfaceKit: o editor visual aparece ao lado da pagina, nunca em
         volta dela — ele monta o proprio container no fim do body e nao
         toca no conteudo.

         O README do pacote monta <InterfaceKit /> como componente React.
         Aqui nao ha React nem {children}: a entrada de raiz do pacote faz
         o mesmo sem framework nenhum, no mesmo formato dos outros scripts
         desta pagina. O import e dinamico dentro do if para o bundle de
         producao nao levar nada disto — o Vite troca import.meta.env.DEV
         por false e o ramo inteiro cai fora. */
      if (import.meta.env.DEV) {
        const { createInterfaceKit } = await import("interface-kit");
        createInterfaceKit({ enabled: true }).mount();
      }
    </script>

    <script>
      /* Amortecimento da rolagem, no site inteiro. Ele proprio decide se
         entra: so desktop, so com ponteiro fino, so para quem nao pediu
         menos movimento. */
      const { montarScrollSuave } = await import("../scripts/scroll-suave");
      const rolagem = montarScrollSuave();

      if (new URLSearchParams(location.search).has("calibrate")) {
        const { mountScrollPanel } = await import("../scripts/scroll-panel");
        mountScrollPanel(rolagem.aplicar);
        const { mountNoisePanel } = await import("../scripts/noise-panel");
        mountNoisePanel();
      }
    </script>
  </body>
</html>
