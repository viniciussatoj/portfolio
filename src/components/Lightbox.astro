---
/**
 * Ampliacao das telas dos cases.
 *
 * Um <dialog> por pagina, a imagem do tamanho que couber na janela. As
 * outras imagens do MESMO bloco (uma Row ou um Split) entram como uma
 * sequencia: setas dos lados, contador em cima, teclado e swipe. Imagem
 * sozinha abre sem setas.
 *
 * Sem JS nada muda: as imagens continuam imagens comuns.
 */
---

<dialog class="lb" aria-label="Image viewer">
  <header class="lb__top">
    <p class="lb__info">
      <span class="lb__count"></span>
      <span class="lb__label"></span>
    </p>
    <button class="lb__btn lb__close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </header>

  <button class="lb__btn lb__nav lb__nav--prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
  </button>

  <figure class="lb__stage">
    <img class="lb__img" alt="" decoding="async" />
  </figure>

  <button class="lb__btn lb__nav lb__nav--next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>

<style>
  /* So as imagens que o script marcou viram clicaveis. */
  :global([data-zoom]) { cursor: zoom-in; }
  :global([data-zoom]:focus-visible) {
    outline: 2px solid var(--yellow);
    outline-offset: 4px;
  }

  /* O dialog cobre a janela inteira: barra em cima, setas dos lados e a
     imagem no meio. */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: hidden;
  }
  .lb[open] {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 72px;
    grid-template-rows: auto minmax(0, 1fr);
    animation: lb-entra .2s ease;
  }
  .lb::backdrop { background: rgb(2 2 2 / .94); }

  .lb__top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-1) var(--space-3);
  }
  .lb__info {
    display: flex;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .lb__count { color: var(--text); white-space: nowrap; }
  .lb__count:empty { display: none; }
  .lb__label {
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A imagem ocupa o que sobra, inteira, sem cortar. Absoluta dentro do
     palco: e o que da uma caixa definida para o max-height em %. Como
     filha de grid, a porcentagem resolvia contra uma trilha automatica,
     era ignorada e a imagem vazava da janela. inset 0 + margin auto
     centraliza nos dois eixos. */
  .lb__stage {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    min-height: 0;
    margin: 0;
  }
  .lb__img {
    position: absolute;
    inset: 0 0 var(--space-3);
    margin: auto;
    display: block;
    max-width: 100%;
    /* O % resolve contra o palco inteiro, nao contra a area do inset:
       o respiro de baixo sai daqui tambem. */
    max-height: calc(100% - var(--space-3));
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    transition: opacity .15s ease;
  }
  .lb__img[data-saindo] { opacity: 0; }

  .lb__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / .1);
    color: var(--text);
    cursor: pointer;
    transition: background .15s ease, color .15s ease;
  }
  .lb__btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lb__btn:hover { background: rgb(255 255 255 / .2); color: var(--yellow); }
  .lb__btn:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

  .lb__nav { grid-row: 2; align-self: center; justify-self: center; margin-bottom: var(--space-3); }
  .lb__nav--prev { grid-column: 1; }
  .lb__nav--next { grid-column: 3; }
  /* Imagem sozinha: sem setas e sem contador. */
  .lb[data-solo] .lb__nav { visibility: hidden; }

  /* A pagina de tras nao rola com o modal aberto. */
  :global(html:has(.lb[open])) { overflow: hidden; }

  @keyframes lb-entra {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb[open] { animation: none; }
    .lb__img { transition: none; }
  }

  /* No mobile a imagem fica com a largura toda; as setas descem para uma
     barra embaixo, ao alcance do polegar. O swipe tambem navega. */
  @media (max-width: 720px) {
    .lb[open] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .lb__top { padding-left: var(--space-2); }
    .lb__stage { grid-column: 1 / -1; }
    .lb__img { inset: 0 var(--space-1); max-width: calc(100% - 2 * var(--space-1)); max-height: 100%; }
    .lb__nav { grid-row: 3; margin: var(--space-2) 0 var(--space-3); }
    .lb__nav--prev { grid-column: 1; justify-self: end; margin-right: var(--space-2); }
    .lb__nav--next { grid-column: 2; justify-self: start; margin-left: var(--space-2); }
    .lb[data-solo] .lb__nav { display: none; }
  }
</style>

<script>
  type Item = { pequena: string; srcset: string; alt: string; rotulo: string };

  const dialog = document.querySelector<HTMLDialogElement>(".lb");
  const tela = dialog?.querySelector<HTMLImageElement>(".lb__img");
  const contador = dialog?.querySelector<HTMLElement>(".lb__count");
  const rotuloEl = dialog?.querySelector<HTMLElement>(".lb__label");

  /* O navegador escolhe no srcset a variante do tamanho da janela, e nao
     o original de 5200px — decodificar o original a cada troca travava. */
  const SIZES = "92vw";

  /* Quem abre o modal: figuras, menos as marcadas com zoom={false}. */
  const AMPLIAVEIS = ".fig img:not([data-no-zoom])";

  let itens: Item[] = [];
  let atual = 0;
  let pedido = 0;

  /** O titulo dentro do modal: o data-lb-label vence a legenda. */
  function rotuloDe(img: HTMLImageElement): string {
    if (img.dataset.lbLabel) return img.dataset.lbLabel;
    return img.closest("figure")?.querySelector(".fig__label")?.textContent?.trim() ?? "";
  }

  /** A sequencia de uma imagem: as irmas do mesmo bloco, na ordem da
   *  pagina. Fora de um bloco, ela sozinha. */
  function grupoDe(img: HTMLImageElement): HTMLImageElement[] {
    const bloco = img.closest<HTMLElement>(".row, .split");
    if (!bloco) return [img];
    const irmas = [...bloco.querySelectorAll<HTMLImageElement>(AMPLIAVEIS)];
    return irmas.length > 1 && irmas.includes(img) ? irmas : [img];
  }

  /** Baixa fora da tela a variante que a tela grande vai pedir, para a
   *  troca nao passar por um quadro em branco. */
  function preparar(it: Item): Promise<void> {
    return new Promise((pronto) => {
      const im = new Image();
      im.decoding = "async";
      im.onload = im.onerror = () => pronto();
      im.sizes = SIZES;
      im.srcset = it.srcset;
      im.src = it.pequena;
      if (im.complete) pronto();
    });
  }

  function pintarInfo() {
    if (contador) contador.textContent = itens.length > 1 ? `${atual + 1} / ${itens.length}` : "";
    if (rotuloEl) rotuloEl.textContent = itens[atual]?.rotulo ?? "";
  }

  function aplicar(it: Item) {
    if (!tela) return;
    tela.sizes = SIZES;
    tela.srcset = it.srcset;
    tela.src = it.pequena;
    tela.alt = it.alt;
  }

  /* Some, troca quando a nova chegou, volta. O numero do pedido descarta
     uma troca que ficou para tras quando o usuario passou rapido. */
  async function ir(i: number) {
    if (!tela || itens.length < 2) return;
    const n = (i + itens.length) % itens.length;
    if (n === atual) return;
    const meu = ++pedido;
    atual = n;
    pintarInfo();
    tela.dataset.saindo = "";
    await Promise.all([preparar(itens[n]), new Promise((r) => setTimeout(r, 150))]);
    if (meu !== pedido) return;
    aplicar(itens[n]);
    revelar();
  }

  /* A imagem so reaparece quando o arquivo novo carregou; ate la o
     navegador seguiria mostrando o anterior. */
  function revelar() {
    if (tela?.complete) delete tela.dataset.saindo;
  }

  function abrir(img: HTMLImageElement) {
    if (!dialog || !tela) return;
    const grupo = grupoDe(img);
    itens = grupo.map((g) => ({
      pequena: g.currentSrc || g.src,
      srcset: g.getAttribute("srcset") ?? "",
      alt: g.alt,
      rotulo: rotuloDe(g),
    }));
    atual = Math.max(0, grupo.indexOf(img));
    pedido++;
    const it = itens[atual];

    dialog.toggleAttribute("data-solo", itens.length < 2);
    tela.dataset.saindo = "";
    // Abre na hora com o que ja esta na tela e sobe de resolucao quando
    // a variante grande chegar.
    tela.removeAttribute("srcset");
    tela.src = it.pequena;
    tela.alt = it.alt;
    revelar();
    const meu = pedido;
    preparar(it).then(() => {
      if (dialog.open && meu === pedido) aplicar(it);
    });

    pintarInfo();
    dialog.showModal();
  }

  if (dialog && tela) {
    tela.addEventListener("load", () => delete tela.dataset.saindo);
    tela.addEventListener("error", () => delete tela.dataset.saindo);

    for (const img of document.querySelectorAll<HTMLImageElement>(AMPLIAVEIS)) {
      img.dataset.zoom = "";
      img.tabIndex = 0;
      img.setAttribute("role", "button");
      /* O rotulo e lido em voz alta: fala a lingua da pagina, que e
         ingles, e nao a do codigo. */
      img.setAttribute("aria-label", img.alt ? `Open full size: ${img.alt}` : "Open full size");
      img.addEventListener("click", () => abrir(img));
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          abrir(img);
        }
      });
    }

    dialog.querySelector(".lb__close")!.addEventListener("click", () => dialog.close());
    dialog.querySelector(".lb__nav--prev")!.addEventListener("click", () => ir(atual - 1));
    dialog.querySelector(".lb__nav--next")!.addEventListener("click", () => ir(atual + 1));

    /* Clique fora da imagem e dos botoes fecha. */
    dialog.addEventListener("click", (e) => {
      const alvo = e.target as HTMLElement;
      if (!alvo.closest(".lb__img, .lb__btn")) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        dialog.close();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        ir(atual + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        ir(atual - 1);
      }
    });

    /* Swipe horizontal no toque. So conta se o gesto foi mais de lado
       do que para cima, para nao brigar com o scroll. */
    let x0 = 0;
    let y0 = 0;
    dialog.addEventListener("touchstart", (e) => {
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    dialog.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) ir(atual + (dx < 0 ? 1 : -1));
    });
  }
</script>
