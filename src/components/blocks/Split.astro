---
/** Duas colunas com fio central do accent — o par "1. / 2." dos cases. */
---
<div class="split"><slot /></div>

<style>
  /* O fio fica fora do fluxo, centralizado no gap. Desenhado como
     border-left da segunda coluna ele consumia 49px da largura util dela
     (borda + padding), e as duas colunas deixavam de ser iguais — os
     mockups renderizavam em tamanhos diferentes. */
  .split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* Figma: colunas de 361 com 32 de cada lado do fio central = 64. */
    gap: 64px;
    /* Figma: 48 do gap entre grupos, mais 32 de padding inferior do
       Frame 753 antes do proximo bloco. */
    margin: 48px 0 80px;
  }
  .split::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--rule-strong, var(--accent-hi));
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .split { grid-template-columns: 1fr; }
    .split::before { display: none; }
  }
</style>
