---
interface Props { cols?: 2 | 3 }
const { cols = 3 } = Astro.props;
---
<div class="row bleed" style={`--cols:${cols}`}><slot /></div>

<style>
  .row { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--gutter); align-items: start; }
  @media (max-width: 720px) {
    .row { 
      grid-template-columns: 1fr; 
         gap: var(--space-1);
  } 
                            }
</style>
