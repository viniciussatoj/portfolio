---
/**
 * Texto corrido do case na largura inteira (padrao do site). Um botao no
 * canto, so no dev (astro dev), liga a coluna de 680px para comparar; no site
 * publicado fica a largura inteira, sem botao. A escolha fica no navegador.
 *
 * So entra no case que inclui <ReadingWidth /> (hoje, o V5).
 */
const dev = import.meta.env.DEV;
---

{dev && (
  <button class="rw-toggle" type="button" aria-pressed="false">
    Body text: <strong>Full width</strong>
  </button>
)}

<script is:inline>
  (function () {
    var KEY = "reading-width";
    var root = document.documentElement;
    var narrow = false;
    try { narrow = localStorage.getItem(KEY) === "680"; } catch (e) {}
    root.classList.toggle("rw-narrow", narrow);

    document.addEventListener("DOMContentLoaded", function () {
      var btn = document.querySelector(".rw-toggle");
      if (!btn) return;
      var paint = function () {
        var isFull = !root.classList.contains("rw-narrow");
        btn.querySelector("strong").textContent = isFull ? "Full width" : "680px";
        btn.setAttribute("aria-pressed", String(!isFull));
      };
      paint();
      btn.addEventListener("click", function () {
        var isFull = !root.classList.toggle("rw-narrow");
        try { localStorage.setItem(KEY, isFull ? "full" : "680"); } catch (e) {}
        paint();
        /* A barra em pixel art do titulo redesenha na nova largura. */
        window.dispatchEvent(new Event("resize"));
      });
    });
  })();
</script>

<style is:global>
  /* Coluna de 680px (so com o botao do dev ligado): texto corrido e
     titulos de secao centrados; imagens e caixas na largura inteira. */
  html.rw-narrow .case__body > p:not(.hl),
  html.rw-narrow .case__body > .sectitle {
    max-width: 680px;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .rw-toggle {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 1000;
    padding: 10px 14px;
    border: 1px solid rgb(255 255 255 / .2);
    border-radius: 999px;
    background: rgb(20 6 10 / .92);
    color: rgb(255 255 255 / .75);
    font: 13px/1 var(--font-body);
    cursor: pointer;
  }
  .rw-toggle strong { color: #fff; font-weight: 600; }
  .rw-toggle:hover { border-color: rgb(255 255 255 / .45); }
</style>
