---
import { Image } from "astro:assets";

interface Props {
  brand: string;
  metrics: { k: string; v: string }[];
  /** Mockup a esquerda. Import de src/assets, nao caminho em string. */
  src?: ImageMetadata;
  alt?: string;
  /** Titulo do painel. O Figma usa "Overview" nos tres cases. */
  title?: string;
}
const { brand, metrics, src, alt, title = "Overview" } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    {src ? <Image src={src} alt={alt ?? ""} loading="eager" /> : <span class="hero__todo">{brand}</span>}
  </div>

  <div class="hero__panel">
    <h2 class="hero__title">{title}</h2>
    <dl class="hero__metrics">
      {metrics.map((m) => (
        <div class="hero__metric">
          <dt>{m.k}</dt>
          <dd>{m.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Painel unico com fio do accent, partido em duas metades: a esquerda
     leva o mockup sobre o gradiente da marca, a direita o resumo sobre
     fundo escuro. No mobile as metades empilham. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 480px) 1fr;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    margin-block: var(--space-4) var(--space-5);
  }

  /* O mockup sangra pela base, como no Figma. */
  .hero__media {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background: radial-gradient(120% 160% at 30% 20%, var(--accent-hi), var(--accent) 70%);
  }
  /* Figma: o mockup mede ~137 numa coluna de 480, ou seja 29%. */
  .hero__media img { display: block; width: 30%; height: auto; }
  .hero__todo { font-size: 1.5rem; font-weight: 600; opacity: .65; align-self: center; }

  .hero__panel {
    /* Figma: branco a 8% sobre o fundo, nao um cinza opaco — deixa o
       gradiente da metade vizinha influenciar a borda. */
    background: rgb(255 255 255 / .08);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__title {
    font-family: var(--font-display2);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgb(255 255 255 / .25);
  }

  .hero__metrics { display: grid; gap: var(--space-2); margin: 0; min-width: 0; }
  .hero__metric dt { font-size: var(--fs-metric); font-weight: 600; line-height: var(--lh-tight); }
  .hero__metric dd { margin: var(--space-1) 0 0; font-size: var(--fs-metric-text, 1rem); line-height: 1.4; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__media { padding-top: var(--space-2); }
    .hero__media img { width: 82%; }
    .hero__panel { padding: var(--space-3); }
    .hero__title { font-size: 1.75rem; }
  }
</style>
