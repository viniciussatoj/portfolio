---
import { Image } from "astro:assets";

interface Props {
  brand: string;
  metrics: { k: string; v: string }[];
  /** Mockup a esquerda. Import de src/assets, nao caminho em string. */
  src?: ImageMetadata;
  alt?: string;
  /** Titulo do painel. O Figma usa "Overview" nos tres cases. */
  title?: string;
}
const { brand, metrics, src, alt, title = "Overview" } = Astro.props;
---

<section class="hero">
  <div class="hero__media" style={src ? `--ar:${src.width} / ${src.height}` : undefined}>
    {/* Fundo CRT, os mesmos parametros dos cards da home. Fica vazio ate o
        WebGL ligar — sem ele sobra o gradiente do CSS, que e o mesmo. O
        mockup fica por cima, sem glitch. */}
    <canvas class="hero__crt" aria-hidden="true"></canvas>
    {
      src
        ? <Image
            src={src}
            alt={alt ?? ""}
            widths={[144, 288, 432, 640, 900, src.width].filter((w, i, a) => w <= src.width && a.indexOf(w) === i)}
            sizes="(max-width: 900px) 82vw, 220px"
            loading="eager"
          />
        : <span class="hero__todo">{brand}</span>
    }
  </div>

  <div class="hero__panel">
    <h2 class="hero__title">{title}</h2>
    <dl class="hero__metrics">
      {metrics.map((m) => (
        <div class="hero__metric">
          <dt>{m.k}</dt>
          <dd>{m.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Painel unico com fio do accent, partido em duas metades: a esquerda
     leva o mockup sobre o gradiente da marca, a direita o resumo sobre
     fundo escuro. No mobile as metades empilham. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 480px) 1fr;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    /* Figma: a coluna principal usa gap 64 entre titulo, hero e conteudo. */
    margin-block: 32px;
  }

  /* Mockup inteiro, com o mesmo respiro em cima e embaixo. */
  .hero__media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background: radial-gradient(120% 160% at 30% 20%, var(--accent-hi), var(--accent) 70%);
  }
  /* O canvas cobre a metade do mockup e desenha o mesmo gradiente do CSS,
     so que com o vidro e o glitch por cima. Sem WebGL ele nunca aparece e
     o gradiente de baixo continua valendo. Quem arredonda os cantos aqui
     e o overflow do .hero, nao o shader — por isso o mount vem com
     rounded: false. */
  .hero__crt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity .4s ease;
  }
  .hero__crt[data-crt="on"] { opacity: 1; }

  /* Figma: o mockup mede ~137 numa coluna de 480, ou seja 29%. */
  .hero__media img { position: relative; z-index: 1; display: block; width: 30%; height: auto; }

  /* Desktop: a imagem ocupa a altura toda do bloco, entre os dois paddings,
     e a largura acompanha na proporcao. A altura do bloco vem da linha do
     grid, ou seja, do que for maior: o painel do Overview ou o espacador.

     O espacador (::before, invisivel) reproduz a altura que a imagem tinha
     com 30% da largura — por isso Liv Up e InvestAI, de painel baixo, ficam
     exatamente como estavam. Quando o painel e mais alto (Hubees), o bloco
     estica e a imagem cresce junto. A imagem fica fora do fluxo para nao
     entrar nessa conta. No mobile nao se aplica: la ela define a altura. */
  @media (min-width: 901px) {
    .hero__media::before {
      content: "";
      width: 30%;
      aspect-ratio: var(--ar, 1 / 2);
    }
    .hero__media img {
      position: absolute;
      top: var(--space-2);
      left: 50%;
      translate: -50% 0;
      height: calc(100% - 2 * var(--space-2));
      width: auto;
    }
  }
  .hero__todo { position: relative; z-index: 1; font-size: 1.5rem; font-weight: 600; opacity: .65; align-self: center; }

  .hero__panel {
    /* Figma: branco a 8% sobre o fundo, nao um cinza opaco — deixa o
       gradiente da metade vizinha influenciar a borda. */
    background: rgb(255 255 255 / .08);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__title {
    font-family: var(--font-display2);
    font-weight: 400;
    /* Figma: Base Neue Wide 24/32. */
    font-size: 1.5rem;
    line-height: 1.3333;
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgb(255 255 255 / .25);
  }

  .hero__metrics { display: grid; gap: var(--space-2); margin: 0; min-width: 0; }
  /* Figma: Hind Madurai Bold 20/24, branco. */
  .hero__metric dt {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  /* Figma: Hind Madurai Regular 16/24, #d1d1d1, colada no titulo — o
     grupo tem gap 0, quem espaca e a entrelinha. */
  .hero__metric dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #d1d1d1;
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__media { padding-top: var(--space-2); }
    .hero__media img { width: 82%; }
    /* Figma mobile: padding 20 em volta. */
    .hero__panel { padding: 20px; }
    /* O Figma mobile mantem os mesmos 24/32 do desktop. */
  }
</style>

<script>
  import { mount } from "../../scripts/crt";
  import { VIGNETTE } from "../../scripts/crt-config";

  const media = document.querySelector<HTMLElement>(".hero__media");
  const canvas = media?.querySelector<HTMLCanvasElement>(".hero__crt");

  if (media && canvas) {
    /* O canvas e uma camada propria no GPU: o overflow do .hero nao corta
       os cantos dele, entao quem arredonda e o shader. Dois cantos so —
       no desktop a metade esquerda, no mobile o topo — e por dentro da
       borda de 1px do painel. */
    const hero = media.closest<HTMLElement>(".hero")!;
    const cantos = () => {
      const r = Math.max(0, parseFloat(getComputedStyle(hero).borderTopLeftRadius) - 1);
      return matchMedia("(min-width: 901px)").matches
        ? ([r, 0, 0, r] as [number, number, number, number])
        : ([r, r, 0, 0] as [number, number, number, number]);
    };

    /* Sem logo: o mockup e um <img> por cima do canvas, sem glitch.

       Tremor horizontal e tremulacao constante ficam zerados so aqui: num
       card pequeno eles dao vida, num banner desta largura viram balanco.
       Sao os unicos dois parametros que o banner nao herda da calibragem —
       inclusive quando o painel esta aberto. */
    const instance = mount(canvas, null, {
      radii: cantos,
      overrides: { jitter: 0, flicker: 0 },
    });

    if (instance) {
      const cs = getComputedStyle(media);
      const id = document.body.dataset.case ?? "";
      const hi = cs.getPropertyValue("--accent-hi").trim() || "#d22047";
      const lo = cs.getPropertyValue("--accent").trim() || "#890029";
      instance.setColors(hi, lo);
      instance.setVignetteColor(VIGNETTE);

      /* Mesmo painel da home, so com este alvo: import dinamico, so com
         ?calibrate na URL. Visitante normal nao baixa esse chunk. */
      if (new URLSearchParams(location.search).has("calibrate")) {
        const { mountPanel, loadColors, loadVignette } = await import("../../scripts/crt-panel");
        const alvo = { id, brand: document.title.split("—")[0].trim() || id, instance, hi, lo };
        const salva = loadColors()[id];
        if (salva) {
          alvo.hi = salva.hi;
          alvo.lo = salva.lo;
          instance.setColors(salva.hi, salva.lo);
        }
        instance.setVignetteColor(loadVignette());
        mountPanel([alvo]);
      }
    }
  }
</script>
