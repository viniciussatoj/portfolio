---
import { Image } from "astro:assets";

interface Props {
  brand: string;
  metrics: { k: string; v: string }[];
  /** Mockup a esquerda. Import de src/assets, nao caminho em string. */
  src?: ImageMetadata;
  alt?: string;
}
const { brand, metrics, src, alt } = Astro.props;
---

<section class="hero bleed">
  <div class="hero__media">
    {src ? <Image src={src} alt={alt ?? ""} loading="eager" /> : <span class="hero__todo">{brand}</span>}
  </div>
  <dl class="hero__metrics">
    {metrics.map((m) => (
      <div class="hero__metric">
        <dt>{m.k}</dt>
        <dd>{m.v}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* O painel sangra 112px para cada lado da coluna de texto, e devolve os
     mesmos 112px em padding — assim o conteudo interno volta a alinhar com
     o titulo e os paragrafos da pagina. */
  .hero {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 4rem;
    padding: var(--space-3) 112px 0;
    border-radius: var(--radius);
    background: radial-gradient(120% 160% at 30% 20%, var(--accent-hi), var(--accent) 70%);
    overflow: hidden;
    margin-bottom:var(--space-2);
  }

  /* Mockup encostado na base do painel, como no Figma. */
  .hero__media { align-self: end; }
  .hero__media img { display: block; width: 240px; height: auto; }
  .hero__todo { font-size: 1.5rem; font-weight: 600; opacity: .65; }

  .hero__metrics { align-self: center; display: grid; gap: var(--space-3); margin: 0; min-width: 0; padding-bottom: var(--space-3); }
  .hero__metric dt { font-size: var(--fs-metric); font-weight: 600; line-height: var(--lh-tight); }
  .hero__metric dd { margin: var(--space-1) 0 0; font-size: var(--fs-metric-text); line-height: 1.4; opacity: .95; }

  /* ---------- CRT + glitch ----------
     O conteudo aqui e imagem e texto reais, entao o efeito trabalha em
     camadas por cima em vez de deslocar o conteudo. pointer-events none
     nas duas: o texto continua selecionavel. */
  .hero {
    position: relative;
    --g: 0;
    --shake: 0px;
    translate: var(--shake) 0;
  }

  /* Vidro do tubo: scanlines e vinheta, sempre presentes. */
  .hero[data-glitch="on"]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    background:
      repeating-linear-gradient(
        to bottom,
        rgb(0 0 0 / var(--p-scanlines, .18)) 0 1px,
        transparent 1px calc(var(--p-scan-size, 3) * 1px)
      ),
      radial-gradient(115% 115% at 50% 50%, transparent 55%, rgb(0 0 0 / var(--p-vignette, .35)));
  }

  /* Rasgadura: uma faixa que salta de posicao e desvia o matiz do que
     esta atras. Aparece com a intensidade, some no repouso. */
  .hero[data-glitch="on"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: var(--s0-top, 50%);
    height: calc(var(--p-tear, 26) * 1px);
    z-index: 3;
    pointer-events: none;
    opacity: var(--g);
    translate: var(--s0-x, 0px) 0;
    backdrop-filter: hue-rotate(calc(var(--p-hue, 24) * 1deg)) saturate(1.6) brightness(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero::after { display: none; }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-2) var(--space-2) 0;
    }
    .hero__media { justify-self: center; }
    .hero__metrics { padding-bottom: var(--space-3); }
  }
</style>

<script>
  import { mountCssGlitch } from "../../scripts/css-glitch";

  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero) mountCssGlitch(hero, "hero");
</script>
