---
/**
 * Duas decisoes lado a lado, cada uma com o proprio titulo, texto e tela:
 * serve quando uma resposta nasce da outra (o que falhou e o que mudou).
 *
 *   <Pair aN="01" aHeading="..." bN="02" bHeading="...">
 *     <Fragment slot="a-text">...</Fragment>
 *     <Fragment slot="a-media">...</Fragment>
 *     <Fragment slot="b-text">...</Fragment>
 *     <Fragment slot="b-media">...</Fragment>
 *   </Pair>
 */
interface Props {
  aN?: string;
  aHeading: string;
  bN?: string;
  bHeading: string;
}
const { aN, aHeading, bN, bHeading } = Astro.props;
---

<section class="pair">
  <div class="pair__item" data-reveal>
    {aN && <span class="pair__n">{aN}</span>}
    <h3 class="pair__h">{aHeading}</h3>
    <div class="pair__text"><slot name="a-text" /></div>
    <div class="pair__media"><slot name="a-media" /></div>
  </div>
  <div class="pair__item" data-reveal="late">
    {bN && <span class="pair__n">{bN}</span>}
    <h3 class="pair__h">{bHeading}</h3>
    <div class="pair__text"><slot name="b-text" /></div>
    <div class="pair__media"><slot name="b-media" /></div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    margin-block: clamp(4rem, 10vw, 8rem);
  }
  .pair__item { display: flex; flex-direction: column; }
  .pair__n {
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .pair__h {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--yellow);
    text-shadow: var(--yellow-glow);
  }
  /* O texto cresce para as duas telas comecarem na mesma linha. */
  .pair__text { flex: 1; }
  .pair__text :global(p) { margin: 0 0 var(--space-2); }
  .pair__media { margin-top: var(--space-3); }

  @media (max-width: 900px) {
    .pair { grid-template-columns: minmax(0, 1fr); }
  }
</style>
