---
/** Citação com fios em cima e embaixo. Use <strong> no slot para os
    trechos em destaque, como no Figma. */
---
<blockquote class="pull"><slot /></blockquote>

<style>
  /* Figma: a citacao visivel (Frame 749) tem 786 — a largura da coluna
     de leitura. O bloco de 1056 que eu media antes era o Frame 756, que
     esta oculto no arquivo. */
  .pull {
    /* O <blockquote> traz margin-inline 40px do navegador — sem zerar,
       a citacao encolhe 80px e nao acompanha a coluna. */
    margin-inline: 0;
    margin-block: var(--space-3);
    padding-block: var(--space-2);
    border-block: 1px solid var(--rule);
    /* Branco puro: a citacao nao herda o #D1D1D1 do corpo do case. */
    color: var(--text);
    font-size: 2rem;
    line-height: 1.5;
    text-align: center;
  }
  .pull :global(strong) { font-weight: 600; }
  .pull :global(p) { margin: 0; }

  @media (max-width: 900px) {
    .pull {
      width: auto;
      margin-inline: 0;
      font-size: 1.25rem;
      text-align: left;
    }
  }
</style>
