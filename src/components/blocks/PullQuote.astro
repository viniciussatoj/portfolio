---
/** Citação com fios do accent em cima e embaixo. Use <strong> no slot
    para os trechos em destaque, como no Figma. */
---
<blockquote class="pull"><slot /></blockquote>

<style>
  
  
  .pull {
    margin: var(--space-4) 0;
    padding: var(--space-2) 0;
    border-block: 1px solid var(--accent);
    font-size: 1.75rem;
    line-height: 2;
    text-align: center;
  }
  .pull :global(strong) { font-weight: 600; }
  .pull :global(p) { margin: 0; }
  @media (max-width: 720px) { .pull { font-size: 1.125rem; text-align: left; } }
</style>
