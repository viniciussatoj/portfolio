---
/**
 * Cabecalho de secao do case — "Development_", "Outcome_".
 *
 * Mesmo tratamento do titulo: display oblíquo com a aberracao cromatica.
 * O underscore final e literal no texto, nao decoracao de CSS, para
 * aparecer na selecao e na busca da pagina como o designer escreveu.
 */
interface Props {
  children?: unknown;
  /** Variante com a barra de gradiente a direita (Figma 354:3716). */
  bar?: boolean;
}
const { bar = false } = Astro.props;
---

<h2 class:list={["sectitle", bar && "sectitle--bar"]}><slot /></h2>

<style>
  .sectitle {
    font-family: var(--font-display2);
    font-weight: 400;
    font-style: normal;
    font-size: var(--fs-section, 2rem);
    line-height: 1.25;   /* Figma: 40 sobre 32 */
    letter-spacing: 0.01em;
    color: var(--text);
    /* Figma: primeiro item do grupo, com gap 32 para o proximo. */
    margin: var(--space-3) 0 var(--space-3);
    text-shadow:
      0 0 4px rgb(255 184 0 / .35),
      1px 0 0 rgb(0 136 255 / .55),
      -1px -1px 0 rgb(255 56 60 / .55),
      0 2px 0 rgb(52 199 89 / .55);
  }

  /* ---- variante com barra (Figma 354:3716) --------------------------
     Auto-layout horizontal, gap 16, itens centrados no eixo cruzado. A
     barra tem layoutGrow 1, ou seja, come toda a largura que sobra —
     e o que o flex: 1 faz aqui.

     Duas diferencas do .sectitle padrao, e as duas vem do Figma: o
     tracking e 0 (nao 0.01em) e as quatro sombras de aberracao estao
     desligadas no no. Por isso o text-shadow: none. */
  .sectitle--bar {
    display: flex;
    align-items: center;
    gap: 16px;
    letter-spacing: 0;
    text-shadow: none;
  }

  .sectitle--bar::after {
    content: "";
    flex: 1 1 auto;
    height: 13px;
    /* Paradas exatas do gradiente do no. */
    background: linear-gradient(
      90deg,
      #ee3d40 0%,
      #fdd802 25%,
      #00ff2b 47.1%,
      #13be99 70.2%,
      #2600ff 95.7%
    );
    /* O Figma aplica um shader de dithering Bayer 16x16 por cima. CSS nao
       quantiza cor por pixel, entao isto e uma aproximacao: uma malha de
       3px que alterna alpha cheio e parcial.

       As celulas alternadas sao atenuadas, nao removidas. Removendo (alpha
       0) a barra perde metade do brilho sobre o fundo preto, e o dithering
       de verdade posteriza sem escurecer. Para o gradiente limpo, remova
       as quatro linhas abaixo. */
    --malha: repeating-conic-gradient(#000 0% 25%, rgb(0 0 0 / .45) 0% 50%);
    mask-image: var(--malha);
    mask-size: 3px 3px;
    -webkit-mask-image: var(--malha);
    -webkit-mask-size: 3px 3px;
  }

  @media (max-width: 900px) {
    .sectitle { font-size: var(--fs-section-mobile, 1.75rem); margin-top: var(--space-4); }
  }
</style>
