---
/**
 * Camada de respiro do V6: mais espaco negativo e leitura mais calma, com
 * base em salciotti.com (OLX Motors) e alexdontsov.com (Biolink).
 *
 * - Texto corrido em branco a 74%, na largura inteira como no resto do site.
 * - Muito mais ar entre secoes (220px antes de cada titulo) e entre
 *   blocos (120-200px), uma ideia por vez.
 * - Destaques viram frases centradas, sem caixa, com espaco em volta.
 *
 * So entra no case que inclui <Breathing /> depois de <Typography />. Os
 * !important existem porque o V5 (Typography.astro) e o template do case
 * usam seletores mais especificos para as mesmas margens.
 */
---

<style is:global>
  /* ---- leitura (texto na largura inteira, como no resto do site) ---- */
  .case__body > p,
  .story__body p,
  .pair__text p,
  .habits-text p {
    font-size: 1.1875rem !important;
    line-height: 1.75 !important;
    color: rgb(255 255 255 / .74);
  }
  .case__body > p { margin-bottom: 1.4em !important; }

  /* ---- secoes ------------------------------------------------------ */
  @media (min-width: 901px) {
    .case__body .sectitle { margin-top: 220px !important; margin-bottom: 56px !important; }
  }

  /* ---- blocos: uma ideia por vez ----------------------------------- */
  .case__body > .frow { margin-block: 120px !important; }
  .case__body .frow__item { padding-block: 40px; }

  .case__body > .cols { margin-block: 120px !important; }
  .case__body .cols:has(> .launch-screen) { margin-top: 96px !important; }
  .case__body .cols:has(> .habits-viz) { margin-top: 120px !important; }
  .case__body > ol.hl-line { margin-top: 96px !important; }

  .case__body > .cards { margin-block: 160px !important; }
  .cards__row { gap: 24px !important; }
  .cards__card { padding: 32px !important; }

  .case__body > .ph { margin-block: 120px !important; }

  .case__body > p + .pair { margin-top: 96px !important; }
  .pair { gap: 96px !important; margin-block: 160px !important; }

  .story { margin-block: 200px !important; gap: 96px !important; }

  .case__body > .brow {
    margin-block: 96px !important;
    padding-block: 56px !important;
  }

  /* ---- destaques: frase centrada, sem caixa ------------------------ */
  .case__body .hl {
    max-width: 760px;
    margin: 180px auto !important;
    padding: 0 !important;
    border-left: 0 !important;
    background: none !important;
    text-align: center;
    font-size: 1.75rem !important;
    font-weight: 500 !important;
    line-height: 1.45 !important;
    color: var(--text);
  }
  @media (max-width: 900px) {
    .case__body .hl { margin: 96px auto !important; font-size: 1.375rem !important; }
    .story, .pair { margin-block: 112px !important; }
    .case__body > .cards, .case__body > .cols { margin-block: 96px !important; }
  }
</style>
