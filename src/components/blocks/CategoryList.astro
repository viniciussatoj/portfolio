---
import { Image } from "astro:assets";

/**
 * Uma coluna do comparativo de catalogo: rotulo + cartao de categorias.
 *
 * O rotulo vem partido em duas porque o Figma so destaca a primeira
 * metade: "Before -" em bold, "Around 100 items" em regular.
 */
interface Props {
  /** Parte em destaque, ex.: "Before -" */
  label: string;
  /** Continuacao em peso normal, ex.: "Around 100 items" */
  detail: string;
  items: { src: ImageMetadata; name: string }[];
}
const { label, detail, items } = Astro.props;
---

<div class="cat">
  <p class="cat__head"><strong>{label}</strong> {detail}</p>
  <ul class="cat__list">
    {items.map((it) => (
      <li class="cat__item">
        <Image src={it.src} alt="" width={48} height={48} loading="lazy" />
        <span>{it.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Coluna presa ao topo: o cartao tem a altura do seu conteudo. Esticar
     deixaria o "Before", que tem um item so, como uma caixa vazia alta. */
  .cat { align-self: start; }

  /* Figma: 24/32, com a primeira metade em bold. */
  .cat__head {
    margin: 0 0 var(--space-2);
    font-size: 1.5rem;
    line-height: 1.3333;
  }
  .cat__head strong { font-weight: 600; }

  /* Figma: fill e borda no mesmo tom claro do accent, raio 8, padding 16. */
  .cat__list {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 8px;
    padding: 16px;
    /* Figma: dashPattern [2,2]. O CSS nao permite ditar o comprimento do
       traco, mas em 1px o dashed do navegador cai praticamente nesse ritmo. */
    border: 1px dashed var(--accent-hi);
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent-hi) 20%, transparent);
  }

  .cat__item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 12px;
  }
  /* O fio separa, entao nao fecha o ultimo item — com um item so, como no
     cartao Before, nao ha fio nenhum. */
  .cat__item:not(:last-child) { border-bottom: 1px solid rgb(246 243 234 / .2); }

  .cat__item img {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }
  .cat__item span { font-weight: 600; }

  @media (max-width: 900px) {
    .cat__head { font-size: 1.25rem; }
    .cat__list { padding: 12px; }
    .cat__item { gap: 16px; }
  }
</style>
