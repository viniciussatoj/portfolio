---
import { Image } from "astro:assets";

/**
 * Cartao de catalogo do Before/After — lista de categorias com miniatura.
 *
 * O rotulo vem partido em duas porque o Figma so destaca a primeira
 * metade: "Before -" em bold, "Around 100 items" em regular.
 */
interface Props {
  /** Parte em destaque, ex.: "Before -" */
  label: string;
  /** Continuacao em peso normal, ex.: "Around 100 items" */
  detail: string;
  items: { src: ImageMetadata; name: string }[];
}
const { label, detail, items } = Astro.props;
---

<div class="cat">
  <p class="cat__head"><strong>{label}</strong> {detail}</p>
  <ul class="cat__list">
    {items.map((it) => (
      <li class="cat__item">
        <Image src={it.src} alt="" width={48} height={48} loading="lazy" />
        <span>{it.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .cat__head {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }
  .cat__head strong { font-weight: 600; }

  /* Cartao: fundo vinho fechado com fio do accent. */
  .cat__list {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 18%, #120309);
  }

  .cat__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }
  /* Fio entre itens, menos no ultimo — separador, nao moldura. */
  .cat__item + .cat__item { border-top: 1px solid rgb(255 255 255 / .12); }

  .cat__item img {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }
  .cat__item span { font-size: var(--fs-body-lg, 1rem); font-weight: 600; }

  @media (max-width: 900px) {
    .cat__list { padding-inline: var(--space-2); }
  }
</style>
