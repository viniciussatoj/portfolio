---
import { Image } from "astro:assets";

/**
 * Uma coluna do comparativo de catalogo: rotulo + cartao de categorias.
 *
 * O rotulo vem partido em duas porque o Figma so destaca a primeira
 * metade: "Before -" em bold, "Around 100 items" em regular.
 */
interface Props {
  /** Parte em destaque, ex.: "Before -" */
  label: string;
  /** Continuacao em peso normal, ex.: "Around 100 items" */
  detail: string;
  items: { src: ImageMetadata; name: string }[];
  /** Colunas da lista no desktop. Os itens enchem a linha da esquerda para a
   *  direita e descem para a proxima, na ordem em que vieram, e cada um
   *  ganha um fio embaixo. Imagem e texto nao mudam. No celular e sempre
   *  uma coluna. */
  columns?: number;
}
const { label, detail, items, columns = 1 } = Astro.props;
/* Primeiro indice da ultima linha da grade: so quem esta nela fica sem fio. */
const inicioUltimaLinha = (Math.ceil(items.length / columns) - 1) * columns;
---

<div class="cat">
  <p class="cat__head"><strong>{label}</strong> {detail}</p>
  {/* Os itens da ultima linha (--fim) nao levam o fio: ele so encostaria na
      borda do cartao. Um item no meio de uma coluna, mesmo sem vizinho
      embaixo, leva o fio (o Pantry, na terceira linha). */}
  <ul class:list={["cat__list", columns > 1 && "cat__list--cols"]} style={columns > 1 ? `--cols: ${columns}` : undefined}>
    {items.map((it, i) => (
      <li class:list={["cat__item", i >= inicioUltimaLinha && "cat__item--fim"]}>
        {/* densities aproveita a fonte de 384px: sem isso o Astro gera um
            unico arquivo de 48px e a miniatura fica borrada em retina. */}
        <Image
          src={it.src}
          alt=""
          width={48}
          height={48}
          densities={[1, 2, 3]}
          loading="lazy"
        />
        <span>{it.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Coluna presa ao topo: o cartao tem a altura do seu conteudo. Esticar
     deixaria o "Before", que tem um item so, como uma caixa vazia alta. */
  .cat { align-self: start; }

  /* Rotulo no corpo de texto, 16/1.5, com a primeira metade em bold. */
  .cat__head {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .cat__head strong { font-weight: 600; }

  /* Fill no tom claro do accent; a borda e um fio preto continuo, que
     recorta o cartao contra o fundo em vez de somar mais uma cor. */
  .cat__list {
    list-style: none;
    margin: 0;
    display: grid;
    /* Sem vao entre os itens: quem separa e o fio de cada linha, e o ar
       vem do padding-block do proprio item. */
    gap: 0;
    padding: 8px 16px;
    border: 1px solid #000000;
    border-radius: 13px;
    background: color-mix(in srgb, var(--accent-hi) 20%, transparent);
  }

  /* Varias colunas (Figma do comparativo): so o arranjo e as bordas mudam.
     A lista le da esquerda para a direita e desce, o cartao ganha a borda
     do accent forte do case (--rule-strong) e cada item um fio embaixo, que
     para na borda da propria coluna. Imagem, texto e respiro dos itens
     ficam como em qualquer lista. */
  .cat__list--cols {
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: 20px;
    border-color: var(--rule-strong, var(--accent-hi));
  }
  .cat__list--cols .cat__item { border-bottom: 1px solid rgb(246 243 234 / .2); }
  .cat__list--cols .cat__item--fim { border-bottom: 0; }

  .cat__item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 12px;
  }
  /* O fio separa, entao nao fecha o ultimo item — com um item so, como no
     cartao Before, nao ha fio nenhum. */
  /*Make the following changes to the components on the `/work/liv-up/` page:

### [ul] "Frozen mealsProduceDairyMeats "
  dom: div.aside > div.aside__side > div > ul.cat__list
  classes: cat__list
  Apply these style updates:
    gap: gap-0.cat__item:not(:last-child) { border-bottom: 1px solid rgb(246 243 234 / .2); }*/

  .cat__item img {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }
  .cat__item span { font-weight: 400; }

  @media (max-width: 900px) {
    /* No celular o cartao e estreito demais para duas colunas: volta a uma. */
    .cat__list--cols { grid-template-columns: minmax(0, 1fr); }
    /* Em uma coluna a "ultima linha" e o ultimo item da lista. */
    .cat__list--cols .cat__item--fim { border-bottom: 1px solid rgb(246 243 234 / .2); }
    .cat__list--cols .cat__item:last-child { border-bottom: 0; }
    /* O tamanho da fonte nao muda mais por largura: 16 ja e o corpo do
       texto, e o ajuste antigo para 1.25rem deixaria o rotulo maior no
       celular do que no desktop. */
    .cat__item { gap: 16px; }
  }
</style>
