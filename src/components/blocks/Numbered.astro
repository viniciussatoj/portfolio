---
interface Props {
  n: number | string;
  heading: string;
  /** Variante com fios em cima e embaixo e o corpo alinhado ao titulo. */
  ruled?: boolean;
}
const { n, heading, ruled = false } = Astro.props;
---

<section class:list={["num", ruled && "num--ruled"]}>
  <header class="num__head">
    <span class="num__n">{n}.</span>
    <h2 class="num__h">{heading}</h2>
  </header>
  <slot />
</section>

<style>
  /* Respiro entre itens numerados soltos: 3em em qualquer largura. Duas
     excecoes: logo apos um h2, onde o titulo de secao ja separa, e dentro
     do Split, que tem o proprio espacamento e precisa das colunas
     alinhadas ao topo dos fios. */
  .num { margin-top: 3em; }
  :global(h2) + .num,
  :global(.split) .num { margin-top: 0; }

  /* Figma (Frame 757/758): 361x80, horizontal, gap 16, alinhado ao topo. */
  .num__head {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: var(--space-3);
  }

  /* A altura minima so faz sentido lado a lado: mantem os mockups de um
     Split comecando na mesma linha quando um titulo quebra e o outro
     nao. Num Numbered sozinho ela so criaria vazio embaixo de um titulo
     de uma linha. */
  :global(.split) .num__head { min-height: 64px; }

  /* Figma: IBM Plex Sans Medium 20 — sans, nao o mono do resto da meta. */
  .num__n {
    flex: none;
    font-family: var(--font-sans);
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.3;
    color: var(--yellow);
    text-shadow: var(--yellow-glow);
  }

  /* Em vez dos 28/40 do Figma: em, relativo ao corpo do texto. Assim o
     titulo acompanha o corpo, que ja cresce no mobile — nao precisa de
     um tamanho fixo por largura. */
  .num__h {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.25em;
    font-weight: 600;
    line-height: 1.5em;
    color: var(--yellow);
    text-shadow: var(--yellow-glow);
  }

  /* ---- variante com fios ---------------------------------------------
     Numero numa coluna, titulo e corpo na outra, de modo que o corpo
     comece exatamente onde comeca o titulo. O cabecalho vira display:
     contents para numero e titulo entrarem direto na grade; o column-gap
     e o mesmo gap de 16 do .num__head.

     Os fios usam --accent, que muda por case (verde no InvestAI), e nao
     --rule, que e global e vinho. */
  .num--ruled {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 16px;
    row-gap: 8px;
    padding-block: 16px;
    border-block: 1px solid var(--accent);
    margin-bottom: var(--space-3);
  }
  .num--ruled .num__head { display: contents; }
  .num--ruled > :global(:not(.num__head)) { grid-column: 2; }
  .num--ruled > :global(p) {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.5;
    color: var(--text);
  }

  @media (max-width: 900px) {
    .num__head { min-height: 0; gap: 12px; margin-top: var(--space-3); margin-bottom: var(--space-2); }
    /* O seletor do Split e mais especifico que o de cima; sem repetir
       aqui, o alinhamento continuaria valendo onde o Split vira uma
       coluna so e nao ha nada para alinhar. */
    :global(.split) .num__head { min-height: 0; }

    /* Menos o Split de 3, que no mobile nao empilha: vira carrossel, e
       os passos voltam a ficar lado a lado. Duas linhas do titulo, que
       e 1.5em de 1.25em do corpo — em em, para valer nas duas larguras
       sem numero magico. */
    :global(.split--3) .num__head { min-height: 3.75em; }
    /* Sem tamanho fixo aqui: o em ja acompanha o corpo, que no mobile
       sobe para 1.125rem. Um rem fixo passaria por cima e deixaria o
       titulo maior no celular do que no desktop. */
    .num--ruled { column-gap: 12px; }
    .num--ruled > :global(p) { font-size: 1.125rem; }
  }
</style>
