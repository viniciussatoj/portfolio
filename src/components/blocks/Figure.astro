---
import { Image } from "astro:assets";

interface Props {
  /** Imagem importada de src/assets — o pipeline converte para webp e
   *  gera srcset. String nao serve aqui, precisa ser o import. */
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  wide?: boolean;
  /** Limita a largura do mockup dentro da coluna, em px. */
  max?: number;
  /** Escapatoria para o atributo sizes. So precisa se a figura sair dos
   *  dois casos previstos abaixo (largura total, ou coluna de Row). */
  sizes?: string;
}
const { src, alt, label, wide = false, max, sizes } = Astro.props;

/* Portfolio de designer: a nitidez importa mais que o byte. Por isso
   quality 90 em vez do padrao (~80), que borra texto miudo de UI.

   O srcset evita o custo disso: sem ele o Astro serve o arquivo inteiro
   — 5120px de largura para um slot de 1280 — a todo mundo. Com ele o
   navegador escolhe pela densidade real da tela. */
const QUALIDADE = 90;
const ESCADA = [400, 640, 900, 1280, 1800, 2400, 3200, 4200, 5200];

/* Uma largura maior que a fonte so faria upscale. */
const larguras = src
  ? Array.from(new Set([...ESCADA.filter((w) => w < src.width), src.width]))
  : undefined;

/* Row vira coluna unica em 720px (ver Row.astro), quando a figura passa a
   ocupar quase a viewport toda. */
const medidas =
  sizes ??
  (wide
    ? "100vw"
    : max
      ? `(max-width: 720px) 92vw, ${max}px`
      : "(max-width: 720px) 92vw, 360px");
---

<figure class:list={["fig", wide && "fig--wide"]} style={max ? `--max:${max}px` : undefined}>
  {label && <figcaption class="meta fig__label">{label}</figcaption>}
  {
    src
      ? <Image
            src={src}
            alt={alt ?? ""}
            widths={larguras}
            sizes={medidas}
            quality={QUALIDADE}
            loading="lazy"
            decoding="async"
          />
      : <div class="fig__todo">imagem pendente de export do Figma{label ? ` — ${label}` : ""}</div>
  }
</figure>

<style>
  .fig { margin: var(--space-1) 0 var(--space-3) 0; }
  .fig--wide { width: 100vw; margin-inline: calc(50% - 50vw); }
  .fig__label { color: var(--text-muted); border-bottom: 1px solid var(--rule); padding-bottom: var(--space-1); margin-bottom: var(--space-2); }
  /* --max limita o mockup dentro da coluna; sem ele ocupa a largura toda. */
  .fig img { width: 100%; max-width: var(--max, 100%); height: auto; border-radius: var(--radius); margin-inline: auto; }
  /* Placeholder deliberadamente visível: melhor obviamente inacabado
     do que silenciosamente quebrado. */
  .fig__todo {
    display: grid;
    place-items: center;
    min-height: 220px;
    border: 1px dashed var(--text-dim);
    border-radius: var(--radius);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-align: center;
    padding: var(--space-2);
  }
</style>
