---
import { Image } from "astro:assets";

interface Props {
  /** Imagem importada de src/assets — o pipeline converte para webp e
   *  gera srcset. String nao serve aqui, precisa ser o import. */
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  wide?: boolean;
  /** Limita a largura do mockup dentro da coluna, em px. */
  max?: number;
  /** Escapatoria para o atributo sizes. So precisa se a figura sair dos
   *  dois casos previstos abaixo (largura total, ou coluna de Row). */
  sizes?: string;
}
const { src, alt, label, wide = false, max, sizes } = Astro.props;

/* A codificacao (WebP near-lossless) vem do astro.config, igual para todas
   as imagens. O srcset controla o peso: sem ele o Astro serve o arquivo
   inteiro — 5120px de largura para um slot de 1280 — a todo mundo. Com
   ele o navegador escolhe pela densidade real da tela. */
const ESCADA = [400, 640, 900, 1280, 1800, 2400, 3200, 4200, 5200];

/* Uma largura maior que a fonte so faria upscale. */
const larguras = src
  ? Array.from(new Set([...ESCADA.filter((w) => w < src.width), src.width]))
  : undefined;

/* Row vira coluna unica em 720px (ver Row.astro), quando a figura passa a
   ocupar quase a viewport toda. */
const medidas =
  sizes ??
  (wide
    ? "(max-width: 900px) 92vw, 960px"
    : max
      ? `(max-width: 720px) 92vw, ${max}px`
      : "(max-width: 720px) 92vw, 360px");
---

<figure class:list={["fig", wide && "fig--wide bleed"]} style={max ? `--max:${max}px` : undefined}>
  {label && <figcaption class="meta fig__label">{label}</figcaption>}
  {
    src
      ? <Image
            src={src}
            alt={alt ?? ""}
            widths={larguras}
            sizes={medidas}
            loading="lazy"
            decoding="async"
          />
      : <div class="fig__todo">imagem pendente de export do Figma{label ? ` — ${label}` : ""}</div>
  }
</figure>

<style>
  /* So as margens verticais aqui. As laterais do wide vem do .bleed global;
     um "margin: x 0" neste seletor com escopo venceria o .bleed e deixaria
     a figura com 960px mas encostada na coluna de texto, estourando a
     direita. O :not zera a margem lateral do UA (40px) so no caso comum. */
  .fig { margin-block: var(--space-1) var(--space-3); }
  .fig:not(.fig--wide) { margin-inline: 0; }
  .fig__label { color: var(--text-muted); border-bottom: 1px solid var(--accent); padding-bottom: var(--space-1); margin-bottom: var(--space-2); }
  /* --max limita o mockup dentro da coluna; sem ele ocupa a largura toda. */
  .fig img { width: 100%; max-width: var(--max, 100%); height: auto; border-radius: var(--radius); margin-inline: auto; }
  /* Placeholder deliberadamente visível: melhor obviamente inacabado
     do que silenciosamente quebrado. */
  .fig__todo {
    display: grid;
    place-items: center;
    min-height: 220px;
    border: 1px dashed var(--text-dim);
    border-radius: var(--radius);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-align: center;
    padding: var(--space-2);
  }
  @media (max-width: 900px) {
    .fig { margin-block: var(--space-1) var(--space-2); }
  }
</style>
