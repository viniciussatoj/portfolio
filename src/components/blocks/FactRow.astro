---
/**
 * Ficha do projeto numa unica faixa: quatro colunas separadas por fios,
 * no mesmo tom das outras linhas do case. Fica logo abaixo do hero, com
 * ar de sobra em cima e embaixo.
 *
 *   <FactRow items={[{ k: "Role", v: "Product Designer" }]} />
 *
 * `v` aceita varias linhas separadas por "|".
 */
interface Item {
  k: string;
  v: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<dl class="frow" data-reveal>
  {items.map((it) => (
    <div class="frow__item">
      <dt class="frow__k">{it.k}</dt>
      <dd class="frow__v">
        {it.v.split("|").map((l) => <span>{l.trim()}</span>)}
      </dd>
    </div>
  ))}
</dl>

<style>
  .frow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: clamp(3rem, 8vw, 6rem);
    border-block: 1px solid var(--accent);
  }
  .frow__item {
    margin: 0;
    padding: var(--space-3) var(--space-2);
    border-left: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .frow__item:first-child { border-left: 0; padding-left: 0; }
  .frow__k {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 100;
    font-style: normal;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
  }
  .frow__v {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    color: var(--text);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .frow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .frow__item:nth-child(odd) { border-left: 0; padding-left: 0; }
    .frow__item:nth-child(n + 3) { border-top: 1px solid color-mix(in srgb, var(--accent) 60%, transparent); }
  }
  @media (max-width: 520px) {
    .frow { grid-template-columns: minmax(0, 1fr); }
    .frow__item { border-left: 0; padding-left: 0; }
    .frow__item + .frow__item { border-top: 1px solid color-mix(in srgb, var(--accent) 60%, transparent); }
  }
</style>
